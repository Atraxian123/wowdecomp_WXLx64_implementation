index 0000000..7082ae5
--- /dev/null
+++ b/Engine/Source/WXLModules/Listfile/ListfileTable.cpp
@@ -0,0 +1,313 @@
+// See ListfileTable.hpp.
+// Copyright (C) 2026 WarcraftXL (GPLv3, see Engine/Source/WXL/Event.h)
+
+#include "ListfileTable.hpp"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdarg>
+#include <cstdio>
+#include <cstring>
+
+#if defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX   // windows.h must not turn std::min / std::max into macros
+#endif
+#include <windows.h>
+#endif
+
+namespace wxl::listfile
+{
+    namespace
+    {
+        constexpr size_t   kChunk         = 1u << 20;      // streaming read size
+        constexpr size_t   kMaxCache      = 65536;         // runtime-mode cache entries before it is cleared
+        constexpr uint64_t kMaxBlobBytes  = 0xFFFFFFF0ull; // offsets are 32-bit
+
+        // A UTF-8 path to a FILE*: the client folder may hold characters outside the ANSI code page.
+        FILE* OpenRead(const std::string& utf8)
+        {
+#if defined(_WIN32)
+            const int n = MultiByteToWideChar(CP_UTF8, 0, utf8.c_str(), -1, nullptr, 0);
+            if (n <= 0) return nullptr;
+            std::wstring w(static_cast<size_t>(n), L'\0');
+            MultiByteToWideChar(CP_UTF8, 0, utf8.c_str(), -1, &w[0], n);
+            return _wfopen(w.c_str(), L"rb");
+#else
+            return std::fopen(utf8.c_str(), "rb");
+#endif
+        }
+
+        void LogF(LogFn log, const char* fmt, ...)
+        {
+            if (!log) return;
+            char line[512];
+            va_list ap;
+            va_start(ap, fmt);
+            std::vsnprintf(line, sizeof(line), fmt, ap);
+            va_end(ap);
+            log(line);
+        }
+
+        // Streams the file line by line (no line is ever longer than the carry buffer can grow: it is a std::string).
+        // fn(begin, end) returns false to stop. A UTF-8 BOM at the start is skipped. @return false when it cannot open.
+        template <class Fn>
+        bool ForEachLine(const std::string& path, Fn&& fn, uint64_t* fileSize = nullptr)
+        {
+            FILE* f = OpenRead(path);
+            if (!f) return false;
+            if (fileSize)
+            {
+                *fileSize = 0;
+                if (std::fseek(f, 0, SEEK_END) == 0)
+                {
+                    const long sz = std::ftell(f);
+                    if (sz > 0) *fileSize = static_cast<uint64_t>(sz);
+                    std::fseek(f, 0, SEEK_SET);
+                }
+            }
+
+            std::vector<char> buf(kChunk);
+            std::string carry;
+            bool first = true, stop = false;
+            size_t got;
+            while (!stop && (got = std::fread(buf.data(), 1, buf.size(), f)) > 0)
+            {
+                const char* p   = buf.data();
+                const char* end = p + got;
+                if (first)
+                {
+                    first = false;
+                    if (got >= 3 && static_cast<unsigned char>(p[0]) == 0xEF && static_cast<unsigned char>(p[1]) == 0xBB &&
+                        static_cast<unsigned char>(p[2]) == 0xBF) p += 3;
+                }
+                while (p < end)
+                {
+                    const char* nl = static_cast<const char*>(std::memchr(p, '\n', static_cast<size_t>(end - p)));
+                    if (!nl) { carry.append(p, end); break; }
+                    if (carry.empty())
+                    {
+                        if (!fn(p, nl)) { stop = true; break; }
+                    }
+                    else
+                    {
+                        carry.append(p, nl);
+                        const bool go = fn(carry.data(), carry.data() + carry.size());
+                        carry.clear();
+                        if (!go) { stop = true; break; }
+                    }
+                    p = nl + 1;
+                }
+            }
+            if (!stop && !carry.empty()) fn(carry.data(), carry.data() + carry.size());   // last line without a newline
+            std::fclose(f);
+            return true;
+        }
+    }
+
+    LineKind ParseLine(const char* b, const char* e, uint32_t& id, const char*& pb, const char*& pe)
+    {
+        while (b < e && (*b == ' ' || *b == '\t')) ++b;
+        while (e > b && (e[-1] == '\r' || e[-1] == '\n' || e[-1] == ' ' || e[-1] == '\t')) --e;
+        if (b == e) return LineKind::Blank;
+
+        uint64_t value = 0;
+        const char* p = b;
+        while (p < e && *p >= '0' && *p <= '9')
+        {
+            value = value * 10 + static_cast<uint64_t>(*p - '0');
+            if (value > 0xFFFFFFFFull) return LineKind::Bad;
+            ++p;
+        }
+        if (p == b || p >= e || (*p != ';' && *p != ',')) return LineKind::Bad;
+        ++p;
+        while (p < e && (*p == ' ' || *p == '\t')) ++p;
+        if (p == e) return LineKind::Bad;
+
+        id = static_cast<uint32_t>(value);
+        pb = p;
+        pe = e;
+        return LineKind::Data;
+    }
+
+    bool Table::Build(std::shared_ptr<State>& out)
+    {
+        const auto t0 = std::chrono::steady_clock::now();
+        auto st = std::make_shared<State>();
+        LoadStats& s = st->stats;
+
+        bool firstLine = true;
+        uint32_t prevId = 0;
+        uint64_t fileSize = 0;
+        bool truncated = false, reserved = false;
+        uint64_t badLogged = 0;
+
+        const bool opened = ForEachLine(m_path, [&](const char* b, const char* e) {
+            uint32_t id = 0;
+            const char *pb = nullptr, *pe = nullptr;
+            const LineKind kind = ParseLine(b, e, id, pb, pe);
+            if (kind == LineKind::Blank) return true;
+            if (kind == LineKind::Bad)
+            {
+                if (firstLine) { s.header = true; firstLine = false; return true; }   // "fileId;path" and the like
+                ++s.badLines;
+                if (badLogged < 3)
+                {
+                    ++badLogged;
+                    LogF(m_log, "listfile: skipped a line that is not '<id>;<path>' (line %llu)",
+                         static_cast<unsigned long long>(s.lines + s.badLines + (s.header ? 1 : 0)));
+                }
+                return true;
+            }
+            firstLine = false;
+            ++s.lines;
+
+            if (st->blob.size() + static_cast<size_t>(pe - pb) + 1 > kMaxBlobBytes) { truncated = true; return false; }
+            if (!reserved && fileSize)
+            {
+                // ~40 bytes a line is typical; the blob holds the paths, which are most of the file
+                reserved = true;
+                st->entries.reserve(static_cast<size_t>(fileSize / 40 + 16));
+                st->blob.reserve(static_cast<size_t>(std::min<uint64_t>(fileSize * 85 / 100, kMaxBlobBytes)));
+            }
+            const uint32_t offset = static_cast<uint32_t>(st->blob.size());
+            for (const char* c = pb; c < pe; ++c) st->blob.push_back(*c == '/' ? '\\' : *c);
+            st->blob.push_back('\0');
+            if (!st->entries.empty() && id < prevId) s.sorted = false;
+            prevId = id;
+            st->entries.push_back({ id, offset });
+            return true;
+        }, &fileSize);
+        if (!opened) return false;
+        if (truncated) LogF(m_log, "listfile: the paths do not fit a 4 GB table: the rest of the file was not read");
+
+        if (!s.sorted)
+            std::stable_sort(st->entries.begin(), st->entries.end(),
+                             [](const Entry& a, const Entry& b) { return a.id < b.id; });
+        // keep the first of equal ids (stable sort kept file order among them)
+        auto last = std::unique(st->entries.begin(), st->entries.end(),
+                                [](const Entry& a, const Entry& b) { return a.id == b.id; });
+        s.duplicates = static_cast<uint64_t>(st->entries.end() - last);
+        st->entries.erase(last, st->entries.end());
+        st->entries.shrink_to_fit();
+        s.entries = st->entries.size();
+        s.ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+        out = std::move(st);
+        return true;
+    }
+
+    bool Table::Configure(std::string path, bool eager)
+    {
+        {
+            std::lock_guard<std::mutex> lock(m_lock);
+            m_path = std::move(path);
+            m_eager = eager;
+            m_state.reset();
+            m_cache.clear();
+            m_missingLogged = false;
+        }
+        return Reload();
+    }
+
+    bool Table::Reload()
+    {
+        if (!m_eager)
+        {
+            std::lock_guard<std::mutex> lock(m_lock);
+            m_cache.clear();
+            m_missingLogged = false;
+            return true;
+        }
+        std::shared_ptr<State> st;
+        if (!Build(st))
+        {
+            LogF(m_log, "listfile: cannot open '%s': every lookup will be answered 'not found'", m_path.c_str());
+            std::lock_guard<std::mutex> lock(m_lock);
+            m_state = std::make_shared<State>();   // an empty table, so Lookup never has to special-case it
+            return false;
+        }
+        const LoadStats& s = st->stats;
+        LogF(m_log, "listfile: eager table built from '%s': %llu entries from %llu lines in %.1f ms "
+                    "(header %s, %s, %llu duplicate id(s), %llu bad line(s))",
+             m_path.c_str(), static_cast<unsigned long long>(s.entries), static_cast<unsigned long long>(s.lines), s.ms,
+             s.header ? "skipped" : "none", s.sorted ? "already sorted" : "sorted on load",
+             static_cast<unsigned long long>(s.duplicates), static_cast<unsigned long long>(s.badLines));
+        std::lock_guard<std::mutex> lock(m_lock);
+        m_state = std::move(st);
+        return true;
+    }
+
+    uint32_t Table::EntryCount() const
+    {
+        std::lock_guard<std::mutex> lock(m_lock);
+        return m_eager && m_state ? static_cast<uint32_t>(m_state->entries.size()) : 0;
+    }
+
+    LoadStats Table::Stats() const
+    {
+        std::lock_guard<std::mutex> lock(m_lock);
+        return m_state ? m_state->stats : LoadStats{};
+    }
+
+    bool Table::ScanFor(uint32_t id, std::string& outPath, bool& fileOpened)
+    {
+        bool found = false;
+        fileOpened = ForEachLine(m_path, [&](const char* b, const char* e) {
+            uint32_t lineId = 0;
+            const char *pb = nullptr, *pe = nullptr;
+            const LineKind kind = ParseLine(b, e, lineId, pb, pe);
+            if (kind == LineKind::Blank) return true;
+            if (kind == LineKind::Bad) return true;                           // header or junk: never an entry
+            if (lineId != id) return true;
+            outPath.assign(pb, pe);
+            for (char& c : outPath) if (c == '/') c = '\\';
+            found = true;
+            return false;                                                     // first entry wins, like the eager table
+        });
+        return found;
+    }
+
+    bool Table::Lookup(uint32_t id, std::string& outPath)
+    {
+        if (m_eager)
+        {
+            std::shared_ptr<const State> st;
+            { std::lock_guard<std::mutex> lock(m_lock); st = m_state; }
+            if (!st) return false;
+            auto it = std::lower_bound(st->entries.begin(), st->entries.end(), id,
+                                       [](const Entry& e, uint32_t v) { return e.id < v; });
+            if (it == st->entries.end() || it->id != id) return false;
+            outPath.assign(st->blob.c_str() + it->offset);
+            return true;
+        }
+
+        {
+            std::lock_guard<std::mutex> lock(m_lock);
+            auto it = m_cache.find(id);
+            if (it != m_cache.end())
+            {
+                if (it->second.found) outPath = it->second.path;
+                return it->second.found;
+            }
+        }
+        // No lock held while the file is read: lookups of other ids are not queued behind this scan.
+        std::string path;
+        bool opened = false;
+        const bool found = ScanFor(id, path, opened);
+
+        std::lock_guard<std::mutex> lock(m_lock);
+        if (!opened)
+        {
+            if (!m_missingLogged)
+            {
+                m_missingLogged = true;
+                LogF(m_log, "listfile: cannot open '%s': every lookup will be answered 'not found'", m_path.c_str());
+            }
+            return false;                                   // not cached: the file may appear later
+        }
+        if (m_cache.size() >= kMaxCache) m_cache.clear();
+        m_cache[id] = Cached{ found, path };
+        if (found) outPath = std::move(path);
+        return found;
+    }
+}
diff --git a/Engine/Source/WXLModules/Listfile/ListfileTable.hpp b/Engine/Source/WXLModules/Listfile/ListfileTable.hpp
new file mode 100644
index 0000000..c724508
--- /dev/null
+++ b/Engine/Source/WXLModules/Listfile/ListfileTable.hpp
@@ -0,0 +1,83 @@
+// The listfile: file id -> file path. Engine-free (no client type, no API table), so it is unit-testable.
+// Copyright (C) 2026 WarcraftXL (GPLv3, see Engine/Source/WXL/Event.h)
+//
+// File format (what the community listfiles and the snippet use): one entry per line, "<id><delimiter><path>",
+// delimiter ';' or ',', CRLF or LF, paths with spaces and forward slashes. A header row is optional: if the first
+// non-blank line does not start with a number it is taken as the header and skipped. A UTF-8 BOM is skipped.
+//
+// Two ways to read it:
+//   eager   the file is read once, at Configure(), into one string blob and a sorted array of (id, offset). A
+//           lookup is a binary search: no allocation but the copy into the caller's string, no disk.
+//   runtime nothing is read at Configure(). A lookup streams the file until it finds the id (first entry wins, as
+//           in eager mode), then caches the answer, hits and misses both, so a repeated lookup costs nothing.
+//           Reload() clears the cache.
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace wxl::listfile
+{
+    /// One finished log line, no newline. May be null.
+    using LogFn = void (*)(const char* line);
+
+    enum class LineKind { Data, Blank, Bad };
+
+    /// Parses one line [b, e): "<id><;|,><path>". On Data, pb/pe delimit the path (trimmed, not NUL-terminated).
+    /// Exposed for the tests.
+    LineKind ParseLine(const char* b, const char* e, uint32_t& id, const char*& pb, const char*& pe);
+
+    struct LoadStats
+    {
+        uint64_t lines      = 0;   ///< non-blank lines read (header excluded)
+        uint64_t entries    = 0;   ///< distinct ids kept
+        uint64_t duplicates = 0;   ///< ids that appeared again (the first entry is the one kept)
+        uint64_t badLines   = 0;   ///< lines that were neither blank nor "<id><;|,><path>"
+        bool     header     = false;
+        bool     sorted     = true;///< the file was already in ascending id order (no sort needed)
+        double   ms         = 0;   ///< time the eager build took
+    };
+
+    class Table
+    {
+    public:
+        explicit Table(LogFn log = nullptr) : m_log(log) {}
+
+        /// Sets the file and the mode. Eager: reads it now. @return false when eager and the file cannot be opened
+        /// (the table stays empty and lookups answer "not found"); runtime mode always returns true.
+        bool Configure(std::string path, bool eager);
+
+        /// The path for an id, backslashes, as the file spells it otherwise. Thread-safe.
+        bool Lookup(uint32_t id, std::string& outPath);
+
+        /// Distinct ids in the eager table; 0 in runtime mode.
+        uint32_t EntryCount() const;
+        bool     Eager() const { return m_eager; }
+        const std::string& Path() const { return m_path; }
+        LoadStats Stats() const;
+
+        /// Reads the file again (eager) or drops the cache (runtime). @return false when eager and unreadable.
+        bool Reload();
+
+    private:
+        struct Entry { uint32_t id; uint32_t offset; };
+        struct State { std::vector<Entry> entries; std::string blob; LoadStats stats; };
+
+        bool Build(std::shared_ptr<State>& out);
+        bool ScanFor(uint32_t id, std::string& outPath, bool& fileOpened);
+
+        LogFn       m_log;
+        std::string m_path;
+        bool        m_eager = true;
+
+        mutable std::mutex                m_lock;
+        std::shared_ptr<const State>      m_state;          // eager table, immutable once published
+        struct Cached { bool found; std::string path; };
+        std::unordered_map<uint32_t, Cached> m_cache;       // runtime mode
+        bool                              m_missingLogged = false;
+    };
+}
diff --git a/Engine/Source/WXLModules/Listfile/Module.cpp b/Engine/Source/WXLModules/Listfile/Module.cpp
new file mode 100644
index 0000000..3b80703
--- /dev/null
+++ b/Engine/Source/WXLModules/Listfile/Module.cpp
@@ -0,0 +1,127 @@
+// The listfile module's entry points. See Engine/Source/WXL/Sdk/wxl_api.h and wxl_listfile_api.h.
+// Copyright (C) 2026 WarcraftXL (GPLv3, see Engine/Source/WXL/Event.h)
+//
+//   WXLExtendedEquipment.ini
+//     [Listfile]
+//     Eager=1                       1 = read listfile.csv once, at load, into a lookup table (default)
+//                                   0 = leave it on disk: each lookup reads the file (answers are cached)
+//     Path=WXL\listfile.csv         relative to the client folder, or absolute
+//     CheckExists=1                 1 = also ask the client whether the file the listfile names is really there
+//     NotFoundName=WXL\NotFound     what a lookup answers for a file that is not found (+ .blp / .m2 by kind): a name
+//                                   the client cannot open, so it falls back to its own missing texture / model
+
+#include "ModuleHost.hpp"
+#include "Resolver.hpp"
+
+#include "wxl_listfile_api.h"
+
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+WXL_DEFINE_MODULE_ABI()
+
+namespace
+{
+    namespace lf = wxl::listfile;
+    namespace host = wxl::modules::host;
+
+    lf::Table    g_table(&host::Log);
+    lf::Resolver g_resolver;
+    bool         g_eager = true;
+
+    // ---- the service: the C-ABI face of the resolver. No exception leaves the module. ----
+
+    int SvcLookupPath(uint32_t id, char* out, size_t cap)
+    {
+        try { return g_resolver.LookupPath(id, out, cap); } catch (...) { return -1; }
+    }
+    int SvcResolve(uint32_t id, uint32_t kind, char* out, size_t cap)
+    {
+        try { return g_resolver.Resolve(id, kind, out, cap); } catch (...) { return WXL_LISTFILE_ERROR; }
+    }
+    int SvcResolvePath(const char* path, uint32_t kind, char* out, size_t cap)
+    {
+        try { return g_resolver.ResolvePath(path, kind, out, cap); } catch (...) { return WXL_LISTFILE_ERROR; }
+    }
+    uint32_t SvcEntryCount() { return g_table.EntryCount(); }
+    int      SvcIsEager()    { return g_eager ? 1 : 0; }
+    int      SvcReload()
+    {
+        try { return g_table.Reload() ? 1 : 0; } catch (...) { return 0; }
+    }
+
+    // Static, valid for the life of the process (the client and other modules keep the pointer).
+    const WxlListfileServices g_services = {
+        sizeof(WxlListfileServices),
+        &SvcLookupPath,
+        &SvcResolve,
+        &SvcResolvePath,
+        &SvcEntryCount,
+        &SvcIsEager,
+        &SvcReload,
+    };
+
+    // The ini spells paths the Windows way. The client is a Windows program, where this changes nothing; elsewhere
+    // (the off-Windows module test) a backslash would be a character of the file name, so turn them into '/'.
+    std::string NativeSeparators(std::string p)
+    {
+#if !defined(_WIN32)
+        for (char& c : p) if (c == '\\') c = '/';
+#endif
+        return p;
+    }
+
+    bool IsAbsolute(const std::string& p)
+    {
+        return (p.size() >= 2 && p[1] == ':') || (!p.empty() && (p[0] == '\\' || p[0] == '/'));
+    }
+}
+
+WXL_MODULE_API int WxlModuleInit(const WxlApi* api, WxlModuleInfo* info)
+{
+    if (info)
+    {
+        std::strncpy(info->name, "listfile", sizeof(info->name) - 1);
+        info->versionMajor = 1;
+        info->versionMinor = 0;
+    }
+
+    // fileExists is the newest member this module uses; it comes after the service ones.
+    if (!api || api->abiVersion != WXL_ABI_VERSION || !WXL_API_HAS(api, fileExists) || !api->log || !api->iniGetBool || !api->iniGetString)
+        return 1;
+    host::SetApi(api);
+
+    g_eager                 = host::IniGetBool("Listfile", "Eager", true);
+    const bool checkExists  = host::IniGetBool("Listfile", "CheckExists", true);
+    std::string path        = host::IniGetString("Listfile", "Path", "WXL\\listfile.csv");
+    const std::string notFound = host::IniGetString("Listfile", "NotFoundName", "WXL\\NotFound");
+    path = NativeSeparators(path);
+    if (!IsAbsolute(path)) path = host::ClientFolder() + path;
+
+    lf::Hooks hooks;
+    hooks.exists = &host::FileExists;
+    hooks.log    = &host::Log;
+    g_resolver.Configure(&g_table, hooks, checkExists, notFound);
+
+    // A missing listfile is not a reason to refuse: the module still loads and answers "not found".
+    g_table.Configure(path, g_eager);
+
+    if (api->registerService(WXL_SERVICE_LISTFILE, &g_services, sizeof(g_services)) != 0)
+    {
+        host::Log("the service " WXL_SERVICE_LISTFILE " is already registered");
+        return 3;
+    }
+
+    char line[640];
+    std::snprintf(line, sizeof(line), "listfile module ready: %s, '%s', existence check %s",
+                  g_eager ? "eager table" : "read at run time", path.c_str(), checkExists ? "on" : "off");
+    host::Log(line);
+    return 0;
+}
+
+WXL_MODULE_API void WxlModuleShutdown(void)
+{
+    // Nothing to tear down: the table is plain memory.
+    host::Log("listfile module shutdown");
+}
diff --git a/Engine/Source/WXLModules/Listfile/ModuleHost.cpp b/Engine/Source/WXLModules/Listfile/ModuleHost.cpp
new file mode 100644
index 0000000..b4e451b
--- /dev/null
+++ b/Engine/Source/WXLModules/Listfile/ModuleHost.cpp
@@ -0,0 +1,67 @@
+// See ModuleHost.hpp.
+// Copyright (C) 2026 WarcraftXL (GPLv3, see Engine/Source/WXL/Event.h)
+
+#include "ModuleHost.hpp"
+
+#if defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX   // windows.h must not turn std::min / std::max into macros
+#endif
+#include <windows.h>
+#else
+#include <unistd.h>
+#endif
+
+namespace wxl::modules::host
+{
+    namespace { const WxlApi* g_api = nullptr; }
+
+    void SetApi(const WxlApi* api) { g_api = api; }
+    const WxlApi* Api() { return g_api; }
+
+    void Log(const char* line)
+    {
+        if (g_api && g_api->log) g_api->log("LISTFILE", line ? line : "");
+    }
+
+    bool IniGetBool(const char* section, const char* key, bool defaultValue)
+    {
+        return g_api && g_api->iniGetBool ? g_api->iniGetBool(section, key, defaultValue ? 1 : 0) != 0 : defaultValue;
+    }
+
+    std::string IniGetString(const char* section, const char* key, const char* defaultValue)
+    {
+        char buf[520] = {};
+        if (g_api && g_api->iniGetString && g_api->iniGetString(section, key, buf, sizeof(buf)) && buf[0]) return buf;
+        return defaultValue ? defaultValue : "";
+    }
+
+    bool FileExists(const char* name)
+    {
+        return g_api && g_api->fileExists && g_api->fileExists(name) != 0;
+    }
+
+    std::string ClientFolder()
+    {
+#if defined(_WIN32)
+        wchar_t w[MAX_PATH * 2] = {};
+        const DWORD n = GetModuleFileNameW(nullptr, w, static_cast<DWORD>(sizeof(w) / sizeof(w[0])));
+        if (n == 0 || n >= sizeof(w) / sizeof(w[0])) return std::string();
+        std::wstring p(w, n);
+        const size_t slash = p.find_last_of(L'\\');
+        if (slash == std::wstring::npos) return std::string();
+        p.resize(slash + 1);
+        const int len = WideCharToMultiByte(CP_UTF8, 0, p.data(), static_cast<int>(p.size()), nullptr, 0, nullptr, nullptr);
+        std::string s(static_cast<size_t>(len), '\0');
+        WideCharToMultiByte(CP_UTF8, 0, p.data(), static_cast<int>(p.size()), &s[0], len, nullptr, nullptr);
+        return s;
+#else
+        char buf[4096] = {};
+        const ssize_t n = readlink("/proc/self/exe", buf, sizeof(buf) - 1);
+        if (n <= 0) return std::string();
+        std::string p(buf, static_cast<size_t>(n));
+        const size_t slash = p.find_last_of('/');
+        return slash == std::string::npos ? std::string() : p.substr(0, slash + 1);
+#endif
+    }
+}
