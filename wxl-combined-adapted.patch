diff --git a/Engine/Source/WXLEquip/EquipExtension.cpp b/Engine/Source/WXLEquip/EquipExtension.cpp
new file mode 100644
index 0000000..c344dec
--- /dev/null
+++ b/Engine/Source/WXLEquip/EquipExtension.cpp
@@ -0,0 +1,3659 @@
+// wxl-equip-extension: equipment slot extension features for WarcraftXL.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#include "Engine/Source/WXLEquip/EquipExtension.hpp"
+#include "Engine/Source/WXLEquip/CreatureExtension.hpp"
+#include "Engine/Source/WXLEquip/WeaponExtension.hpp"
+#include "Engine/Source/WXLEquip/EngineAccess.h"
+#include "Engine/Source/WXLEquip/VirtualPath.hpp"
+#include "Engine/Source/WXL/Event.h"
+#include "Engine/Source/WXL/HandItem.h"
+#include "Engine/Source/WXL/Log.h"
+#include "Engine/Source/WXL/Storage.h"
+#include "WoW/Source/DB/DBClient/DBClient.h"
+#include "WoW/Source/DB/Rec/ChrRacesRec.h"
+#include "WoW/Source/DB/Rec/ItemDisplayInfoRec.h"
+
+#include <windows.h>
+
+#include <cstddef>
+#include <cstdio>
+#include <cstdarg>
+#include <cstdint>
+#include <cstring>
+#include <cstdlib>
+#include <cctype>
+#include <cmath>
+#include <array>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace wxl::scripts::equipextension
+{
+    namespace ev  = wxl::events;
+    namespace eng = wxl::equip::eng;
+
+    // The client's own built-in "missing texture" name: the texture loader special-cases it and hands back the
+    // built-in checker with no file on disk (the same name CreateMaterial substitutes for an empty WMO texture slot).
+    constexpr const char kFallbackTextureName[] = "createcrappygreentexture.blp";
+
+    // ─── Sequence control (animation sync) ───────────────────────────────
+    //
+    // The injected build bound these three by address. In source they are CM2Model methods; the wrappers keep
+    // the extension's call sites unchanged.
+    static bool GM2_HasSequence(void* instance, uint32_t seqId)
+    {
+        return eng::HasSequence(instance, seqId);
+    }
+
+    static uint32_t GM2_GetBoneSequenceId(void* instance, uint32_t slot)
+    {
+        return eng::GetBoneSequenceId(instance, slot);
+    }
+
+    // The injected build's binding named the 5th argument "blendTime" and passed 0.0f. In the decomp it is the
+    // sequence's playback SPEED (the client itself passes 1.0f there), and 0.0f would freeze the pose on its first
+    // frame, so the call uses normal speed instead; the other arguments are passed exactly as before.
+    static void GM2_SetBoneSequence(void* instance, uint32_t slot, uint32_t seqId,
+                                     uint32_t prevSeqId, uint32_t prevSubSeqId,
+                                     float /*blendTime: see above*/, uint32_t loop, uint32_t primary)
+    {
+        eng::SetBoneSequence(instance, slot, seqId, prevSeqId, prevSubSeqId, 1.0f,
+                             static_cast<int32_t>(loop), static_cast<int32_t>(primary));
+    }
+
+
+    // ─── Data types ──────────────────────────────────────────────────────────────
+
+    // List of skinSectionIds to show. count == 0 means "show all" (no filter applied).
+    // WoW geoset IDs are two-part values (e.g. 1301 = group 13, option 01).
+    struct GeosetFilter
+    {
+        uint16_t ids[16];
+        uint32_t count;
+    };
+
+    // Maps collection bone index → character bone index (0xFF = unmatched).
+    // Built by 3-pass matching: (1a) BoneNameCRC, (1b) key_bone_id raw scan, (1c) BoneIndicesByID LUT,
+    //  then (2) parent-chain propagation.
+    // Retail collection M2s (full-body chest pieces etc.) routinely have 60-100+ bones;
+    // 48 was too small and caused the early-exit, leaving count=0 for all collection models.
+    struct BoneRemap
+    {
+        uint16_t count;
+        // true once a build ran against two FULLY PARSED models (even if it matched nothing). false for a default
+        // or reset remap and for one that was attempted too early -- those must be retried, not treated as final.
+        bool     resolved;
+        uint8_t  collToChar[256];
+        void*    collectionModel; // live M2 model this remap was built for (collection side)
+        void*    characterModel;  // live M2 model this remap was built for (character/pose side)
+        // How each collection bone was matched: 0 = unmatched, 1 = bone-name CRC, 2 = key bone id,
+        // 3 = key-bone lookup table, 4 = inherited from its parent bone. Diagnostics only.
+        uint8_t  how[256];
+    };
+
+    struct SidecarModelEntry
+    {
+        uint32_t modelSlot    = static_cast<uint32_t>(-1);
+        uint32_t attachId     = static_cast<uint32_t>(-1);
+        uint32_t modelFlags   = 0x2 | 0x4; // exact path unless the sidecar asks for race/gender suffixes
+        uint32_t textureFlags = 0;
+        char     folder[32]   = {};
+        char     model[264]   = {};
+        char     texture[264] = {};
+        GeosetFilter geoFilter = {};
+    };
+
+    struct SidecarMaterialEntry
+    {
+        uint32_t modelIndex  = static_cast<uint32_t>(-1);
+        uint32_t modelColumn = static_cast<uint32_t>(-1);
+        uint32_t textureType = static_cast<uint32_t>(-1);
+        char     folder[32]  = {};
+        char     model[264]  = {};
+        char     texture[264] = {};
+        char     targetMode[32] = {}; // only "Hide" is consulted now, to skip a row entirely
+    };
+
+    // One attachment entry per attached M2. Keyed by CharModelObject pointer in g_attached.
+    struct AttachEntry
+    {
+        uint32_t    equipSlot = static_cast<uint32_t>(-1); // internal model slot (0-10)
+        uint32_t    attachId  = static_cast<uint32_t>(-1); // WoW attachment point id
+        void*       subObj    = nullptr; // cmo->sceneNode stamped at last rebuild
+        void*       renderCtx = nullptr; // live render context; null = evicted/dead
+        char        keyBuf[264] = {};        // real M2 path (used for matching/dedup)
+        char        mangledKeyBuf[264] = {}; // virtual _wxl_ path for GetRenderCtx (collection only)
+        char        texBuf[264] = {};    // BLP path for BindTexSlot on re-attach
+        char        matTexBuf[2048] = {}; // TextureType-keyed material texture patches for virtual M2 bytes
+        GeosetFilter geoFilter  = {};
+        BoneRemap    boneRemap  = {};
+        uint32_t    mergeKey = 0; // non-zero keeps logical semicolon collection models separate
+        uint32_t    displayId = 0; // ItemDisplayInfo id this entry was built from -- used to key
+                                    // WXLEquipAnimations.csv's opt-in animation-sync lookup.
+        bool        perFrameLogged    = false; // suppress repeated per-frame noise after first log
+        bool        charSweepApplied = false; // set when character-model PerFrame sweep first copies bones
+        bool        bbpLogDone       = false; // suppress OnBuildBonePalette remap dump after first fire
+        bool        cloneBbpLogDone  = false; // suppress duplicate-ModelFrame fallback noise
