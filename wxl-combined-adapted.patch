+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#pragma once
+#include <cstddef>
+#include <cstdint>
+
+#include "Engine/Source/WXL/EventScript.h"
+
+#include "Engine/Source/WXL/Event.h"
+
+namespace wxl::scripts::creatureextension
+{
+    class CreatureExtension : public wxl::events::EventScript
+    {
+    public:
+        CreatureExtension();
+
+    private:
+        // Not model-load-related at all -- reused purely as the earliest possible, unconditional
+        // trigger to kick the one-time sidecar load off. OnModelLoadPre fires for ANY model init
+        // anywhere in the client (see hkM2Init in GameHooks.cpp), including the login/char-select
+        // glue scene's own preview models -- pets, mounts, and weapons can all render there, well
+        // before the client ever enters the actual game world. OnWorldEnter was the previous choice,
+        // but it wraps CWorldEnter specifically, which never fires until character select is already
+        // behind you -- too late for anything shown at the glue screen. Even a completely bare,
+        // unequipped character still has to load its own base body mesh to render at all, so this
+        // fires reliably regardless of gear, unlike OnItemSlotChange before it.
+        //
+        // This is now CreatureExtension's ONLY job: kick off sidecar loading, which itself decides
+        // (via WXLExtendedEquipment.ini's [EagerPreload] Creatures key) whether to also eagerly bake
+        // every sidecar-known displayId's virtual .m2 bytes into the process-lifetime override table
+        // ahead of time. Either way, VirtualPath.cpp's VirtualProvide falls back to a lazy resolver
+        // (CreatureLazyResolve, registered once from this class's constructor) on any displayId that
+        // wasn't already baked -- decoding the exact virtual name the loader just missed on and baking
+        // it on the spot, before that miss is ever handed back. CreatureModelData's ModelName field is
+        // patched at the data level (outside this module) to already name the correct per-displayId
+        // virtual path directly, so the native loader always just asks for the right file on its own,
+        // eager or lazy, with no shared-row corruption risk and no model-instance-cache collision
+        // between displayIds sharing one model file.
+        void OnModelLoadPre(const wxl::events::ModelLoadArgs& a);
+    };
+
+    /// Constructs the extension so its handlers bind to the event bus. Called once from wxl::equip::Init().
+    void Create();
+}
diff --git a/Engine/Source/WXLEquip/EngineAccess.h b/Engine/Source/WXLEquip/EngineAccess.h
new file mode 100644
index 0000000..0f30913
--- /dev/null
+++ b/Engine/Source/WXLEquip/EngineAccess.h
@@ -0,0 +1,166 @@
+// Typed access to the engine objects the equip extension drives.
+// Copyright (C) 2026 WarcraftXL (GPLv3, see Engine/Source/WXL/Event.h)
+//
+// The injected build reached these objects through raw 32-bit offsets (cmo+0x38, inst+0x2C, hdr+0x30 ...)
+// and called engine functions by address. In this tree every one of them is a real member or function,
+// and the offsets are wrong on x64 anyway (pointers are 8 bytes), so this header is the single place
+// that knows how the extension's "cmo / sceneNode / renderCtx / model" vocabulary maps onto the decomp:
+//
+//   cmo        CCharacterComponent*   (the item-slot event's charModelObj)
+//   sceneNode  CM2Model*              cmo->m_data.m_model, the character's own model instance
+//   owner28    CM2Scene*              sceneNode->m_scene, which owns the model cache
+//   renderCtx  CM2Model*              one attached model instance
+//   model      CM2Shared*             the loaded .m2 behind an instance (renderCtx->m_shared)
+//
+// Everything takes and returns void* so the extension's logic reads as it did before the port.
+#pragma once
+
+#include "Engine/Source/Base/Status.h"
+#include "Engine/Source/Model2/M2Data.h"
+#include "Engine/Source/Model2/M2Model.h"
+#include "Engine/Source/Model2/M2Scene.h"
+#include "Engine/Source/Model2/M2Shared.h"
+#include "Engine/Source/Services/Texture.h"
+#include "WoW/Common/ComponentCore/CharacterComponent.h"
+#include "WoW/Source/Glue/ComponentData.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace wxl::equip::eng
+{
+    /// One bone matrix in the palette (CM2Model::m_boneMatrices is a C44Matrix array).
+    constexpr size_t kBonePaletteStride = sizeof(C44Matrix);
+    static_assert(sizeof(C44Matrix) == 0x40, "bone palette stride is 64 bytes");
+
+    // --- CCharacterComponent ("cmo") ---
+
+    inline CM2Model* CmoModel(void* cmo)
+    {
+        return cmo ? static_cast<CCharacterComponent*>(cmo)->m_data.m_model : nullptr;
+    }
+    inline uint32_t CmoRace(void* cmo)
+    {
+        return cmo ? static_cast<CCharacterComponent*>(cmo)->m_data.m_preferences.m_raceID : 0;
+    }
+    inline uint32_t CmoGender(void* cmo)
+    {
+        return cmo ? static_cast<CCharacterComponent*>(cmo)->m_data.m_preferences.m_sexID : 0;
+    }
+
+    // --- CM2Model ("sceneNode" / "renderCtx") ---
+
+    /// The scene that owns the model cache; what GetRenderCtx must be called on.
+    inline void* ModelScene(void* model)
+    {
+        return model ? static_cast<CM2Model*>(model)->m_scene : nullptr;
+    }
+    /// Init flags: bit 0 = animation data ready, bit 18 (0x40000) = attached to root with force.
+    inline uint32_t ModelFlags(void* model)
+    {
+        return model ? static_cast<CM2Model*>(model)->m_fFlags : 0;
+    }
+    /// The instance's bone matrices, or null before its animation data exists.
+    inline uint8_t* ModelBonePalette(void* model)
+    {
+        return model ? reinterpret_cast<uint8_t*>(static_cast<CM2Model*>(model)->m_boneMatrices) : nullptr;
+    }
+    /// The model this instance is attached to (CM2Model::m_attachParent), or null for a root.
+    inline void* ModelParent(void* model)
+    {
+        return model ? static_cast<CM2Model*>(model)->m_attachParent : nullptr;
+    }
+    /// The loaded .m2 behind an instance. The model destructor nulls it, which is the extension's
+    /// "this render context is dead" test.
+    inline void* ModelShared(void* model)
+    {
+        return model ? static_cast<CM2Model*>(model)->m_shared : nullptr;
+    }
+    /// The parsed .m2 header of an instance's model, or null when not loaded yet.
+    inline M2Data* ModelHeader(void* model)
+    {
+        CM2Shared* shared = model ? static_cast<CM2Model*>(model)->m_shared : nullptr;
+        return shared ? shared->m_data : nullptr;
+    }
+
+    // --- CM2Shared ("model") ---
+
+    /// Model path as the cache keyed it. Always a valid, NUL-terminated buffer.
+    inline const char* SharedPath(void* shared)
+    {
+        return shared ? static_cast<CM2Shared*>(shared)->m_fileName : "";
+    }
+    /// The skin profile, or null before it is attached. Index and section arrays are relative
+    /// (M2Array), so they are x64-safe as stored.
+    inline M2SkinProfile* SharedSkin(void* shared)
+    {
+        return shared ? static_cast<CM2Shared*>(shared)->m_skinData : nullptr;
+    }
+
+    // --- Engine calls (formerly gm2:: calls by address) ---
+
+    /// Gets or creates a model instance by path in a scene (0x0081F8F0, CM2Scene::CreateModel).
+    inline void* GetRenderCtx(void* scene, const char* path)
+    {
+        return scene ? static_cast<CM2Scene*>(scene)->CreateModel(path, 0) : nullptr;
+    }
+    /// Attaches child to parent at an attachment id (0x00831630, CM2Model::AttachToParent).
+    /// force bypasses the "attachment point missing -> silently do nothing" exit.
+    inline void AttachToScene(void* child, void* parent, uint32_t attachId, bool force)
+    {
+        static_cast<CM2Model*>(child)->AttachToParent(static_cast<CM2Model*>(parent), attachId, nullptr, force ? 1 : 0);
+    }
+    /// Detaches every child of parent attached at attachId (0x00827560, DetachAllChildrenById).
+    inline void DetachSlot(void* parent, uint32_t attachId)
+    {
+        static_cast<CM2Model*>(parent)->DetachAllChildrenById(attachId);
+    }
+    /// Drops one reference to an instance (0x00824ED0, CM2Model::Release).
+    inline void ReleaseRenderCtx(void* model)
+    {
+        static_cast<CM2Model*>(model)->Release();
+    }
+    /// Binds a texture to replaceable texture type 2 (0x00825260, CM2Model::ReplaceTexture).
+    inline void BindTexSlot(void* model, void* texture)
+    {
+        static_cast<CM2Model*>(model)->ReplaceTexture(2, static_cast<CTexture*>(texture));
+    }
+    /// Loads a texture by path (0x004B9760, TextureCreate) with all-zero texture flags, as before.
+    inline void* LoadResource(const char* path)
+    {
+        CGxTexFlags flags;
+        std::memset(&flags, 0, sizeof(flags));
+        CStatus status;
+        return TextureCreate(path, flags, &status, 0);
+    }
+
+    // --- Animation sequence control (used by the equip animation sync) ---
+
+    /// True when the model's own animation set carries sequence id (0x00825EE0, CM2Model::HasSequence).
+    /// Like the native it waits for the model to finish loading first.
+    inline bool HasSequence(void* model, uint32_t sequenceId)
+    {
+        return model && static_cast<CM2Model*>(model)->HasSequence(sequenceId) != 0;
+    }
+    /// The sequence id currently assigned to a bone; boneId 0xFFFFFFFF means the root/primary bone
+    /// (0x008267E0, CM2Model::GetBoneSequenceId).
+    inline uint32_t GetBoneSequenceId(void* model, uint32_t boneId)
+    {
+        return static_cast<CM2Model*>(model)->GetBoneSequenceId(boneId);
+    }
+    /// Starts a sequence on a bone (0x00832AB0, CM2Model::SetBoneSequence). Argument names follow the decomp:
+    /// variation (0xFFFFFFFF = pick randomly), start time offset, playback speed, blend flag, primary flag.
+    inline void SetBoneSequence(void* model, uint32_t boneId, uint32_t sequenceId, uint32_t variation,
+                                uint32_t time, float speed, int32_t blend, int32_t primary)
+    {
+        static_cast<CM2Model*>(model)->SetBoneSequence(boneId, sequenceId, variation, time, speed, blend, primary);
+    }
+    /// The sequence start anchor (absolute clock, ms) of bone 0: the engine rewrites it every time it (re-)arms a
+    /// sequence on that bone, including a same-id loop restart. Null-safe: 0 before the bone block exists.
+    inline int32_t SeqStartAnchor(void* model)
+    {
+        CM2Model* m = static_cast<CM2Model*>(model);
+        return (m && m->m_bones) ? static_cast<int32_t>(m->m_bones[0].m_sequence.m_startTime) : 0;
+    }
+}
diff --git a/Engine/Source/WXLEquip/Equip.cpp b/Engine/Source/WXLEquip/Equip.cpp
new file mode 100644
index 0000000..c7c0d26
--- /dev/null
+++ b/Engine/Source/WXLEquip/Equip.cpp
@@ -0,0 +1,105 @@
+#include "Engine/Source/WXLEquip/Equip.h"
+
+#include "Engine/Source/BlizzardCore/SFile2-Core.h"
+#include "Engine/Source/WXL/Event.h"
+#include "Engine/Source/WXL/Log.h"
+#include "Engine/Source/WXL/Storage.h"
+#include "Engine/Source/WXLEquip/CreatureExtension.hpp"
+#include "Engine/Source/WXLEquip/EquipExtension.hpp"
+#include "Engine/Source/WXLEquip/VirtualPath.hpp"
+#include "Engine/Source/WXLEquip/WeaponExtension.hpp"
+
+#include <cstdint>
+#include <cstdio>
+#include <vector>
+
+namespace wxl::equip
+{
+    namespace
+    {
+        // Reads a whole file through the client's own open/size/read/close, the same calls the game uses.
+        // Tries archives only first (the injected build's behaviour), then archives plus loose files under
+        // Data\ (open flag 1), so a sidecar dropped loose into the client folder is found too.
+        bool ReadThroughSFile(const char* name, std::vector<uint8_t>& out)
+        {
+            for (uint32_t flags = 0; flags <= 1; ++flags)
+            {
+                SFileImpl* file = nullptr;
+                if (!SFile::OpenEx(nullptr, name, flags, &file) || !file) continue;
+
+                uint32_t sizeHigh = 0;
+                const uint32_t size = SFileGetFileSize(file, &sizeHigh);
+                bool ok = false;
+
+                if (size > 0 && sizeHigh == 0)
+                {
+                    out.resize(size);
+                    uint32_t got = 0;
+                    ok = SFileReadFile(file, out.data(), size, &got, nullptr, 0) && got == size;
+                    if (!ok)
+                    {
+                        wxl::LogCat("EQUIP", "native read of '%s' opened (flags=%u) but read failed: size=%u got=%u",
+                                    name, flags, size, got);
+                        out.clear();
+                    }
+                }
+                else
+                {
+                    wxl::LogCat("EQUIP", "native read of '%s' opened (flags=%u) but size is %u (high=%u): treated as empty",
+                                name, flags, size, sizeHigh);
+                }
+
+                SFileCloseFile(file);
+                if (ok) return true;
+            }
+            return false;
+        }
+
+        // Where do the sidecars live right now? Answers "does it actually see my CSVs" before any model
+        // loads. Only the working directory can be checked this early: game archives are not mounted yet.
+        void ReportSidecarsOnDisk()
+        {
+            static const char* const kNames[] = {
+                "WXLItemDisplayModels.csv", "WXLItemDisplayModelMaterials.csv",
+                "WXLWeaponModels.csv",      "WXLWeaponTextures.csv",
+                "WXLCreatureModels.csv",    "WXLCreatureTextures.csv",
+                "WXLHelmOffsets.csv",       "WXLEquipAnimations.csv",
+            };
+            wxl::LogCat("SIDECAR", "working directory: %s", wxl::WorkingDirectory());
+            for (const char* name : kNames)
+            {
+                char path[512];
+                std::snprintf(path, sizeof(path), "%s", name);
+                bool found = false;
+                for (int pass = 0; pass < 2 && !found; ++pass)
+                {
+                    if (pass == 1) std::snprintf(path, sizeof(path), "DBFilesClient\\%s", name);
+                    if (FILE* f = std::fopen(path, "rb"))
+                    {
+                        std::fseek(f, 0, SEEK_END);
+                        const long size = std::ftell(f);
+                        std::fclose(f);
+                        wxl::LogCat("SIDECAR", "  %-34s found on disk as '%s' (%ld bytes)", name, path, size);
+                        found = true;
+                    }
+                }
+                if (!found)
+                    wxl::LogCat("SIDECAR", "  %-34s not in the working directory (it may still be inside a game archive or a Data\\*.MPQ folder: see the per-file lines at first model load)", name);
+            }
+        }
+    }
+
+    void Init()
+    {
+        wxl::LogCat("EQUIP", "Init: installing native reader, virtual path provider and extensions");
+        wxl::storage::SetNativeReader(&ReadThroughSFile);
+        wxl::scripts::equipextension::VPathRegister();
+        wxl::scripts::equipextension::Create();
+        wxl::scripts::weaponextension::Create();
+        wxl::scripts::creatureextension::Create();
+        ReportSidecarsOnDisk();
+
+        // One glance at which events have handlers; "fired" counts follow once the game reaches each hook.
+        wxl::events::DumpStats();
+    }
+}
