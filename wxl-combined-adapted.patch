+// Hook point for held-weapon model resolution (CCharacterComponent::AddHandItem).
+// Copyright (C) 2026 WarcraftXL (GPLv3, see Event.h)
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace wxl::hooks
+{
+    /**
+     * @brief Callback type: may replace the model file name the client loads for a held weapon.
+     * @param displayId  the ItemDisplayInfo id of the weapon.
+     * @param invSlot    the WoW inventory slot being filled (15 = main hand, 16 = off hand, 17 = ranged).
+     * @param out        receives the replacement file name (bare name, no directory: the client prepends
+     *                   Item\ObjectComponents\Weapon\ or ...\Shield\ itself).
+     * @param outSize    capacity of out.
+     * @return true when out holds a replacement the client must load instead of the record's own Model1.
+     */
+    using HandItemModelResolver = bool (*)(uint32_t displayId, uint32_t invSlot, char* out, size_t outSize);
+
+    /// Registers the resolver. One resolver only; a later call replaces the earlier one.
+    void SetHandItemModelResolver(HandItemModelResolver fn);
+
+    /// Called by AddHandItem before it builds the model path. false when no resolver is set or it declines.
+    bool ResolveHandItemModel(uint32_t displayId, uint32_t invSlot, char* out, size_t outSize);
+
+    /**
+     * @brief Callback type: true when the given CM2Model instance is rendered with a mirrored (handedness-flipping)
+     *        bone palette, so its triangle winding is reversed and the renderer must swap the cull direction.
+     */
+    using MirroredModelQuery = bool (*)(const void* model);
+
+    /// Registers the query. One only; a later call replaces the earlier one.
+    void SetMirroredModelQuery(MirroredModelQuery fn);
+
+    /// Called by the model renderer per material change. Cheap: false immediately when no query is set.
+    bool IsModelMirrored(const void* model);
+}
diff --git a/Engine/Source/WXL/Hooks.h b/Engine/Source/WXL/Hooks.h
new file mode 100644
index 0000000..641cda4
--- /dev/null
+++ b/Engine/Source/WXL/Hooks.h
@@ -0,0 +1,44 @@
+// Helpers for placing WXL hook points inside decompiled functions.
+// Copyright (C) 2026 WarcraftXL (GPLv3, see Event.h)
+#pragma once
+
+#include "Engine/Source/WXL/Event.h"
+
+namespace wxl::events
+{
+    /**
+     * @brief Emits an event when it goes out of scope, i.e. after the surrounding function has run
+     *        and on every return path.
+     *
+     * The original WXL detours ran the native function and then emitted ("call original, then emit").
+     * In source there is no wrapper to put the emit after, so the guard is declared on the first line
+     * of the function and fires when the function exits, early returns included.
+     *
+     * Cheap on the hot path: nothing is emitted unless the event has a subscriber.
+     */
+    template <class Args>
+    class EmitOnExit
+    {
+    public:
+        EmitOnExit(Event e, const Args& args) : m_event(e), m_args(args) {}
+        ~EmitOnExit()
+        {
+            NoteFired(m_event);
+            if (Any(m_event)) Emit(m_event, &m_args);
+        }
+        EmitOnExit(const EmitOnExit&)            = delete;
+        EmitOnExit& operator=(const EmitOnExit&) = delete;
+
+    private:
+        Event m_event;
+        Args  m_args;
+    };
+
+    /// Emits at the call site, before the rest of the function. Skips the work when nothing listens.
+    template <class Args>
+    inline void EmitIfAny(Event e, const Args& args)
+    {
+        NoteFired(e);
+        if (Any(e)) Emit(e, &args);
+    }
+}
diff --git a/Engine/Source/WXL/Log.cpp b/Engine/Source/WXL/Log.cpp
new file mode 100644
index 0000000..a0c90c4
--- /dev/null
+++ b/Engine/Source/WXL/Log.cpp
@@ -0,0 +1,167 @@
+#include "Engine/Source/WXL/Log.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <functional>
+#include <thread>
+#include <unistd.h>
+#endif
+
+namespace wxl
+{
+    namespace
+    {
+        constexpr long long kMaxLogBytes = 256ll * 1024 * 1024; // a runaway log stops here instead of filling the disk
+
+        std::mutex& LogMutex()
+        {
+            static std::mutex m;
+            return m;
+        }
+
+        unsigned ThreadId()
+        {
+#ifdef _WIN32
+            return static_cast<unsigned>(GetCurrentThreadId());
+#else
+            return static_cast<unsigned>(std::hash<std::thread::id>()(std::this_thread::get_id()) & 0xFFFFu);
+#endif
+        }
+
+        struct Timestamp
+        {
+            int h, m, s, ms;
+        };
+
+        Timestamp Now()
+        {
+            Timestamp t = {};
+#ifdef _WIN32
+            SYSTEMTIME st;
+            GetLocalTime(&st);
+            t.h = st.wHour; t.m = st.wMinute; t.s = st.wSecond; t.ms = st.wMilliseconds;
+#else
+            std::time_t now = std::time(nullptr);
+            std::tm* lt = std::localtime(&now);
+            if (lt) { t.h = lt->tm_hour; t.m = lt->tm_min; t.s = lt->tm_sec; }
+#endif
+            return t;
+        }
+
+        bool DecideEnabled()
+        {
+            const char* env = std::getenv("WXL_LOG");
+            if (env && (*env == '0' || *env == 'n' || *env == 'N' || *env == 'f' || *env == 'F')) return false;
+            if (FILE* flag = std::fopen("WXL.log.disable", "rb"))
+            {
+                std::fclose(flag);
+                return false;
+            }
+            return true;
+        }
+
+        struct Sink
+        {
+            FILE*     file    = nullptr;
+            long long written = 0;
+            bool      capped  = false;
+        };
+
+        Sink& GetSink()
+        {
+            static Sink s;
+            return s;
+        }
+
+        void WriteLine(const char* category, const char* format, va_list args)
+        {
+            std::lock_guard<std::mutex> lock(LogMutex());
+            Sink& sink = GetSink();
+            if (sink.capped) return;
+
+            if (!sink.file)
+            {
+                sink.file = std::fopen("WXL.log", "wb"); // truncate: one session per file
+                if (!sink.file) { sink.capped = true; return; }
+                std::fprintf(sink.file, "==== WXL log opened (set WXL_LOG=0 or create WXL.log.disable to turn off) ====\n");
+            }
+
+            const Timestamp t = Now();
+            char body[2048];
+            std::vsnprintf(body, sizeof(body), format, args);
+
+            const int n = std::fprintf(sink.file, "[%02d:%02d:%02d.%03d] [T%u] [%s] %s\n",
+                                       t.h, t.m, t.s, t.ms, ThreadId(), category, body);
+            std::fflush(sink.file); // durable across a crash: the last line written is the last thing that happened
+            if (n > 0) sink.written += n;
+
+            if (sink.written > kMaxLogBytes)
+            {
+                std::fprintf(sink.file, "==== WXL log reached %lld MB, further lines dropped ====\n", kMaxLogBytes >> 20);
+                std::fflush(sink.file);
+                sink.capped = true;
+            }
+        }
+    }
+
+    bool LogEnabled()
+    {
+        static const bool enabled = DecideEnabled();
+        return enabled;
+    }
+
+    void LogCatV(const char* category, const char* format, va_list args)
+    {
+        if (!LogEnabled()) return;
+        WriteLine(category ? category : "WXL", format, args);
+    }
+
+    void LogCat(const char* category, const char* format, ...)
+    {
+        va_list args;
+        va_start(args, format);
+        LogCatV(category, format, args);
+        va_end(args);
+    }
+
+    void Log(const char* format, ...)
+    {
+        va_list args;
+        va_start(args, format);
+        LogCatV("WXL", format, args);
+        va_end(args);
+    }
+
+    bool LogThrottle(const char* key, unsigned first, unsigned every)
+    {
+        static std::mutex s_mutex;
+        static std::unordered_map<std::string, unsigned> s_counts;
+        std::lock_guard<std::mutex> lock(s_mutex);
+        const unsigned n = ++s_counts[key];
+        if (n <= first) return true;
+        return every != 0 && (n % every) == 0;
+    }
+
+    const char* WorkingDirectory()
+    {
+        static const std::string dir = []() {
+            char buf[1024] = {};
+#ifdef _WIN32
+            if (!GetCurrentDirectoryA(sizeof(buf), buf)) return std::string("(unknown)");
+#else
+            if (!getcwd(buf, sizeof(buf))) return std::string("(unknown)");
+#endif
+            return std::string(buf);
+        }();
+        return dir.c_str();
+    }
+}
diff --git a/Engine/Source/WXL/Log.h b/Engine/Source/WXL/Log.h
new file mode 100644
index 0000000..7f30883
--- /dev/null
+++ b/Engine/Source/WXL/Log.h
@@ -0,0 +1,39 @@
+// WXL log: one timestamped, thread-tagged, crash-durable file for every in-tree WXL module.
+// Copyright (C) 2026 WarcraftXL (GPLv3, see Event.h)
+//
+// Output goes to WXL.log in the working directory (the client's folder), truncated at each launch.
+// Every line is flushed as it is written, so the last line is the last thing that happened even when
+// the client crashes. Logging is ON by default; turn it off with env WXL_LOG=0 or by creating a file
+// named WXL.log.disable next to the exe.
+//
+// Line format:  [HH:MM:SS.mmm] [T<thread id>] [CATEGORY] message
+#pragma once
+
+#include <cstdarg>
+
+namespace wxl
+{
+    /// Whether logging is on for this run (decided once, on first use).
+    bool LogEnabled();
+
+    /// printf-style line in category "WXL".
+    void Log(const char* format, ...);
+
+    /// printf-style line in an explicit category (EQUIP, WEAPON, CREATURE, VPATH, STORAGE, BLP, EVENT ...).
+    void LogCat(const char* category, const char* format, ...);
+
+    /// The process working directory (where WXL.log is written and relative sidecar paths resolve).
+    const char* WorkingDirectory();
+
+    /// va_list form of LogCat, for modules that wrap it in their own printf-style helper.
+    void LogCatV(const char* category, const char* format, va_list args);
+
+    /**
+     * @brief Rate limiter for lines that could fire every frame.
+     * @param key    stable string identifying the call site (compared by content).
+     * @param first  how many occurrences to allow before throttling starts.
+     * @param every  after that, allow one occurrence per this many.
+     * @return true when this occurrence should be logged.
+     */
+    bool LogThrottle(const char* key, unsigned first = 8, unsigned every = 1000);
+}
diff --git a/Engine/Source/WXL/Storage.cpp b/Engine/Source/WXL/Storage.cpp
new file mode 100644
index 0000000..a71818e
--- /dev/null
+++ b/Engine/Source/WXL/Storage.cpp
@@ -0,0 +1,80 @@
+#include "Engine/Source/WXL/Storage.h"
+#include "Engine/Source/WXL/Log.h"
+
+#include <atomic>
+#include <vector>
+
+namespace wxl::storage
+{
+    namespace
+    {
+        std::vector<ProviderFn>& Providers()
+        {
+            static std::vector<ProviderFn> s_providers;
+            return s_providers;
+        }
+
+        NativeReadFn g_nativeReader = nullptr;
+    }
+
+    void RegisterProvider(ProviderFn fn)
+    {
+        if (!fn) return;
+        Providers().push_back(fn);
+        wxl::LogCat("STORAGE", "provider registered (total=%zu)", Providers().size());
+    }
+
+    bool HasProviders()
+    {
+        return !Providers().empty();
+    }
+
+    namespace
+    {
+        std::atomic<uint32_t> g_opens{ 0 };
+        std::atomic<uint32_t> g_hits{ 0 };
+    }
+
+    bool TryServe(const char* name, std::vector<uint8_t>& out)
+    {
+        if (!name || !*name) return false;
+
+        const uint32_t opens = ++g_opens;
+        for (ProviderFn fn : Providers())
+        {
+            out.clear();
+            if (fn(name, out))
+            {
+                const uint32_t hits = ++g_hits;
+                if (wxl::LogThrottle("storage.hit", 400, 100))
+                    wxl::LogCat("STORAGE", "SERVED virtual file '%s' (%zu bytes) [hit #%u of %u opens]",
+                                name, out.size(), hits, opens);
+                return true;
+            }
+        }
+
+        if (opens % 20000 == 0)
+            wxl::LogCat("STORAGE", "stats: %u opens offered to providers, %u served virtually", opens, g_hits.load());
+        return false;
+    }
+
+    void SetNativeReader(NativeReadFn fn)
+    {
+        g_nativeReader = fn;
+        wxl::LogCat("STORAGE", "native reader %s", fn ? "installed" : "cleared");
+    }
+
+    bool ReadNative(const char* name, std::vector<uint8_t>& out)
+    {
+        if (!g_nativeReader)
+        {
+            if (wxl::LogThrottle("storage.noreader", 5, 0))
+                wxl::LogCat("STORAGE", "ReadNative('%s') FAILED: no native reader installed", name ? name : "(null)");
+            return false;
+        }
+        const bool ok = g_nativeReader(name, out);
+        if (!ok && wxl::LogThrottle("storage.readfail", 60, 200))
+            wxl::LogCat("STORAGE", "ReadNative('%s') -> not found or unreadable", name ? name : "(null)");
+        return ok;
+    }
+}
diff --git a/Engine/Source/WXL/Storage.h b/Engine/Source/WXL/Storage.h
new file mode 100644
index 0000000..27694d7
--- /dev/null
+++ b/Engine/Source/WXL/Storage.h
@@ -0,0 +1,44 @@
+// WXL virtual-file layer: lets in-tree modules answer a file open with bytes they hold in memory.
+// Copyright (C) 2026 WarcraftXL (GPLv3, see Event.h)
+//
+// The injected WXL detoured the Storm open/size/read/seek/close entry points and built its own handle
+// type. In source none of that is needed: SFileImpl already has an in-memory kind (type 5), so
+// SFile::OpenEx asks TryServe first and, on a hit, returns an ordinary in-memory SFileImpl. Size, read,
+// seek and close then need no change at all.
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+namespace wxl::storage
+{
+    /**
+     * @brief Callback type for a virtual file provider.
+     * @param name  file name as the engine requested it
+     * @param out   receives the file bytes when the provider claims the name
+     * @return true if this provider supplied bytes for name
+     */
+    using ProviderFn = bool (*)(const char* name, std::vector<uint8_t>& out);
+
+    /// Registers a provider. The first provider that claims a name wins. Not thread-safe against
+    /// concurrent opens: register during startup, from wxl::InitModules() or a module's Init().
+    void RegisterProvider(ProviderFn fn);
+
+    /// True when at least one provider is registered, so the open path can skip all work otherwise.
+    bool HasProviders();
+
+    /**
+     * @brief Asks the providers for a file. Called by SFile::OpenEx before it looks in the archives.
+     * @param name  file name from the open call (either slash style, any case)
+     * @param out   receives the bytes on a hit
+     * @return true when a provider claimed the name
+     */
+    bool TryServe(const char* name, std::vector<uint8_t>& out);
+
+    /// Reads a file the way the client would, bypassing nothing: providers see this open too, so a
+    /// provider must not claim a name it is itself trying to read. Installed by the module that links
+    /// the engine (see wxl::equip::Init); WXLCore itself cannot depend on BlizzardCore.
+    using NativeReadFn = bool (*)(const char* name, std::vector<uint8_t>& out);
+    void SetNativeReader(NativeReadFn fn);
+    bool ReadNative(const char* name, std::vector<uint8_t>& out);
+}
