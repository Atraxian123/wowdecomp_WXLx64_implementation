@@ -0,0 +1,43 @@
+// BLP transcode: re-encode an uncompressed-BGRA (encoding 3) image to DXT5 the Client decodes.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#pragma once
+
+#include <cstdint>
+#include <span>
+#include <vector>
+
+// The Client's texture loader decodes palettized (1) and DXT (2) BLP, but NOT the uncompressed-BGRA
+// encoding (3) introduced after it. A modern source ships smooth textures (skies) as encoding 3, which the
+// Client cannot read -> they render white. This re-encodes an encoding-3 image to DXT5 (encoding 2), which
+// the Client reads, keeping the full mip chain. Pure bytes -> bytes.
+namespace wxl::modern::assets::textures::blp
+{
+    // Transcode an encoding-3 BLP to DXT5. Returns false (serve raw) for any other encoding or a non-BLP.
+    bool TranscodeBlp(std::span<const uint8_t> in, std::vector<uint8_t>& out);
+
+    // Character component textures are CPU-composited by the client. Native components are palettized
+    // BLP2 (encoding 1), while modern retail components are commonly DXT. Converts DXT components to that
+    // legacy shape, using the mip whose long edge fits the native-style component budget.
+    bool TextureComponentToPaletted(std::span<const uint8_t> in, std::vector<uint8_t>& out,
+                                    uint32_t maxEdge = 256);
+
+    // Caps a BLP's larger edge to maxEdge by dropping the top mip level(s) and re-basing the mip table:
+    // a 2048 texture is served as its existing 1024 mip, a 4096 as its 1024 mip, etc. No decode/re-encode,
+    // so it works for any encoding and loses nothing below the dropped level. Returns false (no change) for
+    // a non-BLP, an image already within maxEdge, or one whose mip chain is too short to reach maxEdge.
+    bool CapBlpMips(std::span<const uint8_t> in, std::vector<uint8_t>& out, uint32_t maxEdge);
+}
diff --git a/Engine/Source/WXL/Blp/Dxt.hpp b/Engine/Source/WXL/Blp/Dxt.hpp
new file mode 100644
index 0000000..4de4213
--- /dev/null
+++ b/Engine/Source/WXL/Blp/Dxt.hpp
@@ -0,0 +1,89 @@
+// Compact DXT5 (BC3) block compressor: range-fit endpoints, enough for smooth gradient textures.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#pragma once
+
+#include <cstdint>
+#include <cstdlib>
+
+// One 4x4 RGBA block -> 16-byte DXT5 (BC3): an 8-byte alpha block (2 endpoints + 16 3-bit indices) then an
+// 8-byte DXT1 color block (2 RGB565 endpoints + 16 2-bit indices). Range-fit (min/max endpoints): not the
+// optimal compressor, but correct and decodable, and good enough for the smooth sky gradients that need it.
+namespace wxl::modern::assets::textures::blp::dxt
+{
+    inline uint16_t Pack565(int r, int g, int b)
+    {
+        return static_cast<uint16_t>(((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3));
+    }
+    inline void Unpack565(uint16_t c, int& r, int& g, int& b)
+    {
+        r = ((c >> 11) & 0x1F) << 3; g = ((c >> 5) & 0x3F) << 2; b = (c & 0x1F) << 3;
+    }
+
+    // px = 16 RGBA texels (row-major 4x4). out = 16 bytes.
+    inline void CompressBlock(const uint8_t px[64], uint8_t out[16])
+    {
+        // --- alpha (BC3 alpha) ---
+        uint8_t amin = 255, amax = 0;
+        for (int i = 0; i < 16; ++i) { uint8_t a = px[i * 4 + 3]; if (a < amin) amin = a; if (a > amax) amax = a; }
+        out[0] = amax; out[1] = amin; // a0 >= a1 -> 8-alpha interpolation mode
+        uint8_t al[8];
+        al[0] = amax; al[1] = amin;
+        for (int i = 1; i < 7; ++i) al[i + 1] = static_cast<uint8_t>(((7 - i) * amax + i * amin) / 7);
+        uint64_t aidx = 0;
+        for (int i = 0; i < 16; ++i)
+        {
+            int a = px[i * 4 + 3], best = 0, bd = 1 << 30;
+            for (int j = 0; j < 8; ++j) { int d = std::abs(a - al[j]); if (d < bd) { bd = d; best = j; } }
+            aidx |= static_cast<uint64_t>(best) << (3 * i);
+        }
+        for (int i = 0; i < 6; ++i) out[2 + i] = static_cast<uint8_t>(aidx >> (8 * i));
+
+        // --- color (DXT1) ---
+        int rmn = 255, gmn = 255, bmn = 255, rmx = 0, gmx = 0, bmx = 0;
+        for (int i = 0; i < 16; ++i)
+        {
+            int r = px[i * 4], g = px[i * 4 + 1], b = px[i * 4 + 2];
+            if (r < rmn) rmn = r; if (g < gmn) gmn = g; if (b < bmn) bmn = b;
+            if (r > rmx) rmx = r; if (g > gmx) gmx = g; if (b > bmx) bmx = b;
+        }
+        uint16_t c0 = Pack565(rmx, gmx, bmx), c1 = Pack565(rmn, gmn, bmn);
+        if (c0 < c1) { uint16_t t = c0; c0 = c1; c1 = t; } // c0 > c1 -> 4-colour mode
+        out[8] = uint8_t(c0); out[9] = uint8_t(c0 >> 8); out[10] = uint8_t(c1); out[11] = uint8_t(c1 >> 8);
+        if (c0 == c1) { out[12] = out[13] = out[14] = out[15] = 0; return; } // flat block, all index 0
+
+        int cr[4], cg[4], cb[4];
+        Unpack565(c0, cr[0], cg[0], cb[0]);
+        Unpack565(c1, cr[1], cg[1], cb[1]);
+        for (int k = 0; k < 3; ++k)
+        {
+            int* e = (k == 0) ? cr : (k == 1) ? cg : cb;
+            e[2] = (2 * e[0] + e[1]) / 3; e[3] = (e[0] + 2 * e[1]) / 3;
+        }
+        uint32_t cidx = 0;
+        for (int i = 0; i < 16; ++i)
+        {
+            int r = px[i * 4], g = px[i * 4 + 1], b = px[i * 4 + 2], best = 0, bd = 1 << 30;
+            for (int j = 0; j < 4; ++j)
+            {
+                int dr = r - cr[j], dg = g - cg[j], db = b - cb[j], d = dr * dr + dg * dg + db * db;
+                if (d < bd) { bd = d; best = j; }
+            }
+            cidx |= static_cast<uint32_t>(best) << (2 * i);
+        }
+        for (int i = 0; i < 4; ++i) out[12 + i] = static_cast<uint8_t>(cidx >> (8 * i));
+    }
+}
diff --git a/Engine/Source/WXL/CMakeLists.txt b/Engine/Source/WXL/CMakeLists.txt
new file mode 100644
index 0000000..7c2ccba
--- /dev/null
+++ b/Engine/Source/WXL/CMakeLists.txt
@@ -0,0 +1,27 @@
+# WarcraftXL, in-tree. The event bus and the extension base class, compiled straight into the client.
+# No detours and no offsets: a hook point is an ev::Emit() call placed in the decompiled function.
+# The target is named WXLCore because an unrelated "Event" target already exists in this tree.
+file(GLOB_RECURSE PRIVATE_SOURCES CONFIGURE_DEPENDS "*.cpp")
+
+add_library(WXLCore STATIC
+    ${PRIVATE_SOURCES}
+)
+
+target_include_directories(WXLCore
+    PUBLIC
+        ${CMAKE_SOURCE_DIR}
+)
+
+# BlpTranscode.cpp uses std::span (C++20); the rest of the tree is C++17. Only this target moves up, and
+# its public headers (Event.h, Hooks.h, Blp.h, Log.h, WXL.h) stay C++17-clean.
+set_target_properties(WXLCore PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED ON)
+
+target_include_directories(WXLCore
+    PRIVATE
+        ${CMAKE_CURRENT_SOURCE_DIR}/Blp
+)
+
+# Crash.cpp symbolizes call stacks with DbgHelp when the PDB is next to the exe.
+if(WIN32)
+    target_link_libraries(WXLCore PUBLIC dbghelp)
+endif()
diff --git a/Engine/Source/WXL/Crash.cpp b/Engine/Source/WXL/Crash.cpp
new file mode 100644
index 0000000..0a963aa
--- /dev/null
+++ b/Engine/Source/WXL/Crash.cpp
@@ -0,0 +1,166 @@
+#include "Engine/Source/WXL/Crash.h"
+
+#ifdef _WIN32
+
+#include "Engine/Source/WXL/Log.h"
+
+#include <windows.h>
+#include <dbghelp.h>
+
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <unordered_map>
+
+namespace wxl
+{
+    namespace
+    {
+        std::mutex g_symMutex;
+        bool       g_symReady = false;
+
+        const char* BaseName(const char* path)
+        {
+            const char* slash = std::strrchr(path, '\\');
+            return slash ? slash + 1 : path;
+        }
+
+        /// "module+0xRVA" always, plus "function+0xOFF (file:line)" when DbgHelp finds the PDB.
+        void Describe(void* address, char* out, size_t outSize)
+        {
+            char moduleName[MAX_PATH] = "?";
+            HMODULE module = nullptr;
+            uintptr_t rva = 0;
+            if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                   static_cast<LPCSTR>(address), &module) && module)
+            {
+                GetModuleFileNameA(module, moduleName, sizeof(moduleName));
+                rva = reinterpret_cast<uintptr_t>(address) - reinterpret_cast<uintptr_t>(module);
+            }
+
+            int n = std::snprintf(out, outSize, "%s+0x%llX", BaseName(moduleName), static_cast<unsigned long long>(rva));
+
+            std::lock_guard<std::mutex> lock(g_symMutex);
+            if (!g_symReady)
+            {
+                SymSetOptions(SYMOPT_UNDNAME | SYMOPT_DEFERRED_LOADS | SYMOPT_LOAD_LINES);
+                g_symReady = SymInitialize(GetCurrentProcess(), nullptr, TRUE) != FALSE;
+            }
+            if (!g_symReady || n <= 0 || static_cast<size_t>(n) >= outSize) return;
+
+            alignas(SYMBOL_INFO) char symBuf[sizeof(SYMBOL_INFO) + 256] = {};
+            SYMBOL_INFO* sym = reinterpret_cast<SYMBOL_INFO*>(symBuf);
+            sym->SizeOfStruct = sizeof(SYMBOL_INFO);
+            sym->MaxNameLen   = 255;
+            DWORD64 displacement = 0;
+            if (SymFromAddr(GetCurrentProcess(), reinterpret_cast<DWORD64>(address), &displacement, sym))
+            {
+                n += std::snprintf(out + n, outSize - n, "  %s+0x%llX", sym->Name, static_cast<unsigned long long>(displacement));
+                IMAGEHLP_LINE64 line = {};
+                line.SizeOfStruct = sizeof(line);
+                DWORD lineDisp = 0;
+                if (n > 0 && static_cast<size_t>(n) < outSize &&
+                    SymGetLineFromAddr64(GetCurrentProcess(), reinterpret_cast<DWORD64>(address), &lineDisp, &line))
+                    std::snprintf(out + n, outSize - n, "  (%s:%lu)", BaseName(line.FileName), line.LineNumber);
+            }
+        }
+
+        const char* CodeName(DWORD code)
+        {
+            switch (code)
+            {
+                case EXCEPTION_ACCESS_VIOLATION:      return "ACCESS_VIOLATION";
+                case EXCEPTION_STACK_OVERFLOW:        return "STACK_OVERFLOW";
+                case EXCEPTION_ILLEGAL_INSTRUCTION:   return "ILLEGAL_INSTRUCTION";
+                case EXCEPTION_INT_DIVIDE_BY_ZERO:    return "INT_DIVIDE_BY_ZERO";
+                case EXCEPTION_IN_PAGE_ERROR:         return "IN_PAGE_ERROR";
+                case 0xC0000374:                      return "HEAP_CORRUPTION";
+                case 0xC0000409:                      return "STACK_BUFFER_OVERRUN/FAST_FAIL";
+                case 0xC0000096:                      return "PRIVILEGED_INSTRUCTION";
+                default:                              return "EXCEPTION";
+            }
+        }
+
+        bool IsInteresting(DWORD code)
+        {
+            switch (code)
+            {
+                case EXCEPTION_ACCESS_VIOLATION:
+                case EXCEPTION_STACK_OVERFLOW:
+                case EXCEPTION_ILLEGAL_INSTRUCTION:
+                case EXCEPTION_INT_DIVIDE_BY_ZERO:
+                case EXCEPTION_IN_PAGE_ERROR:
+                case 0xC0000374:
+                case 0xC0000409:
+                case 0xC0000096:
+                    return true;
+                default:
+                    return false;
+            }
+        }
+
+        LONG CALLBACK Handler(PEXCEPTION_POINTERS info)
+        {
+            const EXCEPTION_RECORD* rec = info->ExceptionRecord;
+            if (!IsInteresting(rec->ExceptionCode)) return EXCEPTION_CONTINUE_SEARCH;
+
+            // Stack overflow leaves almost no stack: log the bare minimum, then let it propagate.
+            const bool stackOverflow = rec->ExceptionCode == EXCEPTION_STACK_OVERFLOW;
+
+            static std::mutex s_mutex;
+            static std::unordered_map<void*, unsigned> s_seen;
+            {
+                std::lock_guard<std::mutex> lock(s_mutex);
+                unsigned& n = s_seen[rec->ExceptionAddress];
+                if (++n > 4) return EXCEPTION_CONTINUE_SEARCH; // same spot again and again: already on record
+            }
+
+            if (stackOverflow)
+            {
+                wxl::LogCat("CRASH", "STACK_OVERFLOW at %p", rec->ExceptionAddress);
+                return EXCEPTION_CONTINUE_SEARCH;
+            }
+
+            char where[512];
+            Describe(rec->ExceptionAddress, where, sizeof(where));
+            wxl::LogCat("CRASH", "%s (0x%08lX) at %s  [first-chance: a __try guard may handle this]",
+                        CodeName(rec->ExceptionCode), rec->ExceptionCode, where);
+
+            if (rec->ExceptionCode == EXCEPTION_ACCESS_VIOLATION && rec->NumberParameters >= 2)
+            {
+                const ULONG_PTR kind = rec->ExceptionInformation[0];
+                wxl::LogCat("CRASH", "  %s address 0x%llX",
+                            kind == 0 ? "read of" : kind == 1 ? "write to" : kind == 8 ? "execute of" : "access to",
+                            static_cast<unsigned long long>(rec->ExceptionInformation[1]));
+            }
+
+            void* frames[32] = {};
+            const USHORT count = CaptureStackBackTrace(1, 32, frames, nullptr);
+            for (USHORT i = 0; i < count; ++i)
+            {
+                char line[512];
+                Describe(frames[i], line, sizeof(line));
+                wxl::LogCat("CRASH", "  #%u %s", static_cast<unsigned>(i), line);
+            }
+            return EXCEPTION_CONTINUE_SEARCH;
+        }
+    }
+
+    void InstallCrashLogger()
+    {
+        static bool s_done = false;
+        if (s_done) return;
+        s_done = true;
+        AddVectoredExceptionHandler(1, &Handler);
+        wxl::LogCat("CRASH", "crash logger installed");
+    }
+}
+
+#else
+
+namespace wxl
+{
+    void InstallCrashLogger() {}
+}
+
+#endif
diff --git a/Engine/Source/WXL/Crash.h b/Engine/Source/WXL/Crash.h
new file mode 100644
index 0000000..6ee32f2
--- /dev/null
+++ b/Engine/Source/WXL/Crash.h
@@ -0,0 +1,16 @@
+// WXL crash logger: records where the client died, with function names when the PDB is present.
+// Copyright (C) 2026 WarcraftXL (GPLv3, see Event.h)
+#pragma once
+
+namespace wxl
+{
+    /**
+     * @brief Installs a first-chance exception logger (Windows only; a no-op elsewhere).
+     *
+     * Writes the exception code, faulting address, access type and a symbolized call stack to WXL.log.
+     * It never handles the exception, so the client's own crash handling still runs. Access violations
+     * are expected now and then (the equip code probes engine memory under __try on purpose), so each
+     * distinct faulting address is logged only a limited number of times and marked as possibly handled.
+     */
+    void InstallCrashLogger();
+}
diff --git a/Engine/Source/WXL/Event.cpp b/Engine/Source/WXL/Event.cpp
new file mode 100644
index 0000000..6a520ad
--- /dev/null
+++ b/Engine/Source/WXL/Event.cpp
@@ -0,0 +1,131 @@
+// Event bus: subscriber storage + dispatch.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#include "Engine/Source/WXL/Event.h"
+#include "Engine/Source/WXL/Log.h"
+
+#include <atomic>
+#include <vector>
+
+namespace
+{
+    /// One subscriber: a handler function pointer and its opaque user pointer.
+    struct Sub { wxl::events::Handler fn; void* user; };
+
+    /**
+     * @brief Returns the subscriber vector for an event, built on first use.
+     * @param e  event whose bucket is requested.
+     * @return reference to the event's subscriber vector.
+     */
+    std::vector<Sub>& Bucket(wxl::events::Event e)
+    {
+        static std::vector<Sub> buckets[static_cast<size_t>(wxl::events::Event::Count)];
+        return buckets[static_cast<size_t>(e)];
+    }
+}
+
+namespace wxl::events
+{
+    /**
+     * @brief Appends a handler to an event's subscriber list.
+     * @param e        event to subscribe to.
+     * @param handler  function pointer invoked on Emit.
+     * @param user     opaque pointer passed back to the handler.
+     */
+    void Subscribe(Event e, Handler handler, void* user)
+    {
+        if (e < Event::Count) Bucket(e).push_back({ handler, user });
+    }
+
+    /**
+     * @brief Invokes every subscriber of an event in subscription order.
+     * @param e     event to publish.
+     * @param args  typed args struct for the event, passed by const pointer.
+     */
+    void Emit(Event e, const void* args)
+    {
+        if (e >= Event::Count) return;
+        for (const Sub& s : Bucket(e)) s.fn(s.user, args);
+    }
+
+    /**
+     * @brief Reports whether an event has at least one subscriber.
+     * @param e  event to test.
+     * @return true when Emit(e, ...) would invoke at least one handler.
+     */
+    bool Any(Event e)
+    {
+        return e < Event::Count && !Bucket(e).empty();
+    }
+
+    uint32_t SubscriberCount(Event e)
+    {
+        return e < Event::Count ? static_cast<uint32_t>(Bucket(e).size()) : 0;
+    }
+
+    const char* EventName(Event e)
+    {
+        switch (e)
+        {
+            case Event::OnModelLoadPre:      return "OnModelLoadPre";
+            case Event::OnModelLoad:         return "OnModelLoad";
+            case Event::OnM2SkinFinalize:    return "OnM2SkinFinalize";
+            case Event::OnM2PerFrameUpdate:  return "OnM2PerFrameUpdate";
+            case Event::OnBuildBonePalette:  return "OnBuildBonePalette";
+            case Event::OnItemSlotChange:    return "OnItemSlotChange";
+            case Event::OnItemSlotClear:     return "OnItemSlotClear";
+            case Event::OnHandItemAttached:  return "OnHandItemAttached";
+            default:                         return "Event#?";
+        }
+    }
+
+    namespace
+    {
+        std::atomic<uint32_t>& Fired(Event e)
+        {
+            static std::atomic<uint32_t> counts[static_cast<size_t>(Event::Count)];
+            return counts[static_cast<size_t>(e)];
+        }
+    }
+
+    void NoteFired(Event e)
+    {
+        if (e >= Event::Count) return;
+        const uint32_t n = ++Fired(e);
+
+        // The first firings of each event say "this hook point is alive"; the rare, important events are
+        // also followed by a full counter dump so one glance shows the whole pipeline's state.
+        if (n <= 3)
+            wxl::LogCat("EVENT", "%s fired #%u (subscribers=%u)", EventName(e), n, SubscriberCount(e));
+
+        const bool rare = e == Event::OnItemSlotChange || e == Event::OnItemSlotClear || e == Event::OnHandItemAttached;
+        if ((rare && n <= 6) || (e == Event::OnM2PerFrameUpdate && n % 50000 == 0))
+            DumpStats();
+    }
+
+    void DumpStats()
+    {
+        for (uint32_t i = 0; i < static_cast<uint32_t>(Event::Count); ++i)
+        {
+            const Event e = static_cast<Event>(i);
+            const uint32_t fired = Fired(e).load();
+            const uint32_t subs  = SubscriberCount(e);
+            if (fired == 0 && subs == 0) continue;
+            wxl::LogCat("EVENT", "  stats %-20s fired=%-8u subscribers=%u%s", EventName(e), fired, subs,
+                        (fired == 0 && subs != 0) ? "   <-- subscribed but the hook point has never run" : "");
+        }
+    }
+}
