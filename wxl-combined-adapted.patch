+    static uint32_t RenderCtxBoneCountGuarded(void* renderCtx) noexcept
+    {
+        if (!renderCtx) return 0;
+        __try
+        {
+            const M2Data* header = eng::ModelHeader(renderCtx);
+            if (!header) return 0;
