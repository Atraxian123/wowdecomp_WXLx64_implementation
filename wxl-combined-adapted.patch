index 0000000..0a87ba2
--- /dev/null
+++ b/Engine/Source/WXLEquip/WeaponExtension.cpp
@@ -0,0 +1,1073 @@
+// wxl-weapon-extension: sidecar-driven weapon retexturing for WarcraftXL.
