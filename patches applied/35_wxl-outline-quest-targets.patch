diff --git a/Engine/Source/WXLOutline/QuestMatch.h b/Engine/Source/WXLOutline/QuestMatch.h
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/Engine/Source/WXLOutline/QuestMatch.h
@@ -0,0 +1,92 @@
+// Pure matching rules for the quest outline: "does this creature / object matter to my open quests".
+// Copyright (C) 2026 WarcraftXL (GPLv3, see Engine/Source/WXL/Event.h)
+//
+// Engine-free on purpose, so a host test can run it. Outline.cpp fills a QuestNeeds from the quest log and the
+// quest cache (what is still missing), then asks it about each visible creature and object using what the client's
+// own caches say about them (entry id, kill credits, the quest items they can hold).
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace wxl::outline
+{
+    class QuestNeeds
+    {
+    public:
+        /// A kill / interact objective still short of its count. The quest cache stores a creature as its entry id
+        /// and a game object as the negated entry id (0 means no objective).
+        void AddObjective(int32_t creatureOrGameObject)
+        {
+            if (creatureOrGameObject != 0) m_objectives.push_back(creatureOrGameObject);
+        }
+
+        /// A quest item still short of the count the quest wants.
+        void AddItem(uint32_t itemId)
+        {
+            if (itemId != 0) m_items.push_back(itemId);
+        }
+
+        bool Empty() const { return m_objectives.empty() && m_items.empty(); }
+
+        /// A creature counts for an open objective under its own entry or under one of its kill-credit entries.
+        bool NeedsCreature(uint32_t entry, const uint32_t* killCredit, size_t killCreditCount) const
+        {
+            if (HasObjective(static_cast<int32_t>(entry))) return true;
+            for (size_t i = 0; killCredit && i < killCreditCount; ++i)
+                if (killCredit[i] && HasObjective(static_cast<int32_t>(killCredit[i]))) return true;
+            return false;
+        }
+
+        bool NeedsGameObject(uint32_t entry) const
+        {
+            return entry != 0 && HasObjective(-static_cast<int32_t>(entry));
+        }
+
+        /// Whether any of the quest items a creature or game object can hold is one a quest still wants.
+        bool NeedsItemFrom(const uint32_t* questItems, size_t count) const
+        {
+            for (size_t i = 0; questItems && i < count; ++i)
+                if (questItems[i] && std::find(m_items.begin(), m_items.end(), questItems[i]) != m_items.end())
+                    return true;
+            return false;
+        }
+
+    private:
+        bool HasObjective(int32_t id) const
+        {
+            return id != 0 && std::find(m_objectives.begin(), m_objectives.end(), id) != m_objectives.end();
+        }
+
+        std::vector<int32_t>  m_objectives;
+        std::vector<uint32_t> m_items;
+    };
+
+    /// 0xRRGGBB (or the bare hex digits) into the 0..1 floats the mask shader takes. False on anything else.
+    inline bool ParseHexColor(const char* text, float* rgb)
+    {
+        if (!text) return false;
+        if (text[0] == '#') ++text;
+        else if (text[0] == '0' && (text[1] == 'x' || text[1] == 'X')) text += 2;
+
+        uint32_t v = 0;
+        int digits = 0;
+        for (; *text; ++text, ++digits)
+        {
+            const char c = *text;
+            uint32_t d;
+            if (c >= '0' && c <= '9')      d = static_cast<uint32_t>(c - '0');
+            else if (c >= 'a' && c <= 'f') d = static_cast<uint32_t>(c - 'a' + 10);
+            else if (c >= 'A' && c <= 'F') d = static_cast<uint32_t>(c - 'A' + 10);
+            else return false;
+            v = (v << 4) | d;
+        }
+        if (digits != 6) return false;
+        rgb[0] = static_cast<float>((v >> 16) & 0xFF) / 255.0f;
+        rgb[1] = static_cast<float>((v >> 8) & 0xFF) / 255.0f;
+        rgb[2] = static_cast<float>(v & 0xFF) / 255.0f;
+        return true;
+    }
+}
diff --git a/Tools/WxlModuleTest/questmatch_test.cpp b/Tools/WxlModuleTest/questmatch_test.cpp
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/Tools/WxlModuleTest/questmatch_test.cpp
@@ -0,0 +1,59 @@
+// Host-side test of the quest outline's matching rules (Engine/Source/WXLOutline/QuestMatch.h). No game data.
+// Build and run it with run_questmatch_tests.sh.
+#include <cstdio>
+
+#include "Engine/Source/WXLOutline/QuestMatch.h"
+
+static int g_pass = 0, g_fail = 0;
+#define CHECK(cond, msg) do { if (cond) ++g_pass; else { ++g_fail; std::printf("  FAIL: %s (line %d)\n", msg, __LINE__); } } while (0)
+
+int main()
+{
+    using wxl::outline::QuestNeeds;
+    using wxl::outline::ParseHexColor;
+
+    QuestNeeds none;
+    CHECK(none.Empty(), "nothing added: empty");
+    CHECK(!none.NeedsCreature(1234, nullptr, 0), "empty needs match no creature");
+    CHECK(!none.NeedsGameObject(77), "empty needs match no object");
+
+    QuestNeeds n;
+    n.AddObjective(1234);   // kill creature 1234
+    n.AddObjective(-5678);  // use game object 5678
+    n.AddObjective(0);      // no objective: ignored
+    n.AddItem(900);
+    n.AddItem(0);           // no item: ignored
+    CHECK(!n.Empty(), "objectives and items added");
+
+    CHECK(n.NeedsCreature(1234, nullptr, 0), "creature matched by its own entry");
+    CHECK(!n.NeedsCreature(1235, nullptr, 0), "other creature does not match");
+    CHECK(!n.NeedsCreature(5678, nullptr, 0), "a game object objective is not a creature");
+    CHECK(n.NeedsGameObject(5678), "game object matched by its negated entry");
+    CHECK(!n.NeedsGameObject(1234), "a creature objective is not a game object");
+    CHECK(!n.NeedsGameObject(0), "entry 0 never matches");
+
+    const uint32_t credit[2] = { 0, 1234 };
+    CHECK(n.NeedsCreature(4444, credit, 2), "creature matched through a kill-credit entry");
+    const uint32_t noCredit[2] = { 0, 0 };
+    CHECK(!n.NeedsCreature(4444, noCredit, 2), "zero kill credits match nothing");
+
+    const uint32_t drops[6] = { 0, 0, 900, 0, 0, 0 };
+    const uint32_t other[6] = { 1, 2, 3, 0, 0, 0 };
+    CHECK(n.NeedsItemFrom(drops, 6), "creature or object that can hold a missing quest item");
+    CHECK(!n.NeedsItemFrom(other, 6), "holds only unrelated items");
+    CHECK(!n.NeedsItemFrom(nullptr, 6), "no item list");
+    CHECK(!n.NeedsItemFrom(drops, 2), "only the first two slots looked at");
+
+    float c[3] = {};
+    CHECK(ParseHexColor("00C8FF", c) && c[0] == 0.0f && c[2] == 1.0f && c[1] > 0.78f && c[1] < 0.79f, "plain hex");
+    CHECK(ParseHexColor("#ff0000", c) && c[0] == 1.0f && c[1] == 0.0f, "# prefix, lower case");
+    CHECK(ParseHexColor("0xFFD100", c) && c[0] == 1.0f && c[2] == 0.0f, "0x prefix");
+    CHECK(!ParseHexColor("", c), "empty is not a color");
+    CHECK(!ParseHexColor("FFF", c), "three digits is not accepted");
+    CHECK(!ParseHexColor("GG0000", c), "non hex digit");
+    CHECK(!ParseHexColor("00C8FF00", c), "eight digits is not accepted");
+    CHECK(!ParseHexColor(nullptr, c), "null");
+
+    std::printf("\n%d passed, %d failed\n", g_pass, g_fail);
+    return g_fail ? 1 : 0;
+}
