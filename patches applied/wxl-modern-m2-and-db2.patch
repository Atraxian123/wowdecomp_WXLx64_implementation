--- /dev/null
+++ b/Engine/Source/WXL/ModernM2/ModernM2.cpp
@@ -0,0 +1,127 @@
+// WXL modern M2: registry of natively loaded models, session counters, and the TXID texture-name side table.
+#include "ModernM2.h"
+#include "../Log.h"
+
+#include <atomic>
+#include <mutex>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+namespace wxl::modern::m2
+{
+namespace
+{
+    std::mutex                                           g_mu;
+    std::unordered_set<const void*>                      g_bodies;  // bodies PrepareContainer accepted
+    std::unordered_set<const void*>                      g_models;  // shared models loaded through the native reader
+    std::unordered_map<const void*, std::vector<uint32_t>> g_txid;  // shared model -> FileDataIDs, texture-indexed
+    std::atomic<FileDataIdResolver>                      g_resolver{ nullptr };
+
+    std::atomic<uint32_t> g_native{ 0 }, g_failed{ 0 }, g_texOk{ 0 }, g_texMiss{ 0 }, g_normalized{ 0 };
+    std::atomic<uint32_t> g_skipTxac{ 0 }, g_skipLdv1{ 0 }, g_skipAfid{ 0 }, g_skipSkid{ 0 }, g_skipOther{ 0 };
+    std::atomic<uint32_t> g_extSeq{ 0 };
+
+    void CountSkips(uint32_t mask)
+    {
+        if (mask & kSkipTxac)  g_skipTxac.fetch_add(1, std::memory_order_relaxed);
+        if (mask & kSkipLdv1)  g_skipLdv1.fetch_add(1, std::memory_order_relaxed);
+        if (mask & kSkipAfid)  g_skipAfid.fetch_add(1, std::memory_order_relaxed);
+        if (mask & kSkipSkid)  g_skipSkid.fetch_add(1, std::memory_order_relaxed);
+        if (mask & kSkipOther) g_skipOther.fetch_add(1, std::memory_order_relaxed);
+    }
+}
+
+void OnPrepared(const void* shared, const void* body, const LoadReport& r, const char* name)
+{
+    {
+        std::lock_guard<std::mutex> lock(g_mu);
+        g_bodies.insert(body);
+        g_models.insert(shared);
+        if (r.txidCount) g_txid[shared].assign(r.txid, r.txid + r.txidCount);
+        else             g_txid.erase(shared);
+    }
+    g_native.fetch_add(1, std::memory_order_relaxed);
+    g_normalized.fetch_add(r.particlesNormalized + r.camerasNormalized, std::memory_order_relaxed);
+    g_extSeq.fetch_add(r.extSeqPending, std::memory_order_relaxed);
+    CountSkips(r.skipMask);
+
+    wxl::LogCat("MODERNM2", "'%s' read natively (v=%u body=%u txid=%u skips=0x%X extseq=%u normalized: particles=%u cameras=%u)",
+                name ? name : "?", r.version, r.bodySize, r.txidCount, r.skipMask, r.extSeqPending,
+                r.particlesNormalized, r.camerasNormalized);
+    if (r.extSeqPending)
+        wxl::LogCat("MODERNM2", "'%s' has %u streamed (.anim) sequence(s): bind pose until they arrive",
+                    name ? name : "?", r.extSeqPending);
+}
+
+void OnRejected(const char* name, const LoadReport& r)
+{
+    g_failed.fetch_add(1, std::memory_order_relaxed);
+    CountSkips(r.skipMask);
+    wxl::LogCat("MODERNM2", "'%s' native read FAILED: %s (v=%u skips=0x%X)", name ? name : "?",
+                r.fail ? r.fail : "unknown", r.version, r.skipMask);
+}
+
+void Forget(const void* shared, const void* body)
+{
+    std::lock_guard<std::mutex> lock(g_mu);
+    if (body)   g_bodies.erase(body);
+    if (shared) { g_txid.erase(shared); g_models.erase(shared); }
+}
+
+bool IsPreparedBody(const void* body)
+{
+    std::lock_guard<std::mutex> lock(g_mu);
+    return g_bodies.find(body) != g_bodies.end();
+}
+
+bool IsModernModel(const void* shared)
+{
+    std::lock_guard<std::mutex> lock(g_mu);
+    return g_models.find(shared) != g_models.end();
+}
+
+void SetFileDataIdResolver(FileDataIdResolver fn) { g_resolver.store(fn, std::memory_order_release); }
+
+const char* ResolveTextureName(const void* shared, uint32_t textureIndex)
+{
+    uint32_t fdid = 0;
+    {
+        std::lock_guard<std::mutex> lock(g_mu);
+        auto it = g_txid.find(shared);
+        if (it == g_txid.end() || textureIndex >= it->second.size()) return nullptr;
+        fdid = it->second[textureIndex];
+    }
+    if (!fdid) return nullptr;
+
+    FileDataIdResolver resolve = g_resolver.load(std::memory_order_acquire);
+    const char* path = resolve ? resolve(fdid) : nullptr;
+    if (!path)
+    {
+        g_texMiss.fetch_add(1, std::memory_order_relaxed);
+        if (wxl::LogThrottle("modernm2.txid.unresolved", 16, 500))
+            wxl::LogCat("MODERNM2", "TXID %u unresolved (texture %u): solid white fallback%s", fdid, textureIndex,
+                        resolve ? "" : " (no FileDataID resolver registered)");
+        return nullptr;
+    }
+    g_texOk.fetch_add(1, std::memory_order_relaxed);
+    return path;
+}
+
+Stats GetStats()
+{
+    Stats s{};
+    s.modelsNative        = g_native.load(std::memory_order_relaxed);
+    s.modelsFailed        = g_failed.load(std::memory_order_relaxed);
+    s.texturesResolved    = g_texOk.load(std::memory_order_relaxed);
+    s.texturesUnresolved  = g_texMiss.load(std::memory_order_relaxed);
+    s.recordsNormalized   = g_normalized.load(std::memory_order_relaxed);
+    s.skippedTxac         = g_skipTxac.load(std::memory_order_relaxed);
+    s.skippedLdv1         = g_skipLdv1.load(std::memory_order_relaxed);
+    s.skippedAfid         = g_skipAfid.load(std::memory_order_relaxed);
+    s.skippedSkid         = g_skipSkid.load(std::memory_order_relaxed);
+    s.skippedOtherChunks  = g_skipOther.load(std::memory_order_relaxed);
+    s.externalSeqPending  = g_extSeq.load(std::memory_order_relaxed);
+    return s;
+}
+}
