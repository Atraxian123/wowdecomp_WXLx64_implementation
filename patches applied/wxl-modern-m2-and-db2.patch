@@ -0,0 +1,101 @@
+// WXL modern M2: reads models authored for newer game versions (MD21 container, inner version 272-274)
+// directly into the client's own model runtime. Ported in-tree from the wxl-modern-m2 extension.
+//
+// Design on x64: the engine's own M2Init already relocates a WotLK-shaped body, so the extension's
+// offset->pointer walk is not reimplemented. What is left is everything that must happen to the RAW body
+// first: de-chunk, in-place field deltas, record normalization to the WotLK widths. That part needs no
+// engine access, so it lives here (WXLCore) and CM2Shared::FinishLoading calls it.
+//
+// Public header: keep it C++17-clean, Model2 (C++17) includes it.
+#pragma once
+
+#include <cstdint>
+
+namespace wxl::modern::m2
+{
+    /// Inner MD20 versions read natively (Legion .. later builds share one record shape per record type).
+    constexpr uint32_t kSourceVersionMin = 272;
+    constexpr uint32_t kSourceVersionMax = 274;
+    constexpr uint32_t kMaxTxid = 128; // observed max is 7 textures; hard cap for the POD copy
+
+    /// Auxiliary chunks the reader found but cannot use. Reported in LoadReport::skipMask and the log.
+    enum : uint32_t
+    {
+        kSkipTxac     = 0x01,
+        kSkipLdv1     = 0x02, ///< LOD skin data: profile 0 only
+        kSkipAfid     = 0x04, ///< external .anim ids
+        kSkipSkid     = 0x08, ///< .skel skeleton: load refused
+        kSkipPhysBone = 0x10, ///< PFID / BFID
+        kSkipOther    = 0x80,
+    };
+
+    /// Everything one load learned, POD.
+    struct LoadReport
+    {
+        uint32_t    version;
+        uint32_t    bodySize;
+        uint32_t    skipMask;
+        uint32_t    extSeqPending;      ///< sequences whose keys stream from a .anim file
+        uint32_t    particlesNormalized;
+        uint32_t    camerasNormalized;
+        uint32_t    txidCount;
+        uint32_t    txid[kMaxTxid];     ///< FileDataIDs from the TXID chunk, indexed like header.textures
+        const char* fail;               ///< static failure reason when PrepareContainer returned false
+    };
+
+    /// Session counters (all monotonic).
+    struct Stats
+    {
+        uint32_t modelsNative;
+        uint32_t modelsFailed;
+        uint32_t texturesResolved;
+        uint32_t texturesUnresolved;
+        uint32_t recordsNormalized;
+        uint32_t skippedTxac, skippedLdv1, skippedAfid, skippedSkid, skippedOtherChunks;
+        uint32_t externalSeqPending;
+    };
+
+    /// True when the buffer starts with the raw 'MD21' chunk tag. One compare: stock models pay nothing else.
+    bool IsContainer(const uint8_t* buf, uint32_t size);
+
+    /**
+     * @brief De-chunks an MD21 container in place and brings its body onto the WotLK record shapes.
+     *
+     * The MD20 body is slid to buf (the allocation pointer the owner frees is untouched), then: sequence and
+     * material deltas, skin-profile count clamp, record normalization (particles, cameras), reference clamps.
+     * Every access is bounds-checked against the body: malformed input is a clean failure, never a fault.
+     * @param buf     container bytes (modified in place).
+     * @param size    in: container size; out: body size on success.
+     * @param report  receives the harvest; on false, report->fail names the reason.
+     * @return true when buf now holds a body the engine's M2Init can relocate.
+     */
+    bool PrepareContainer(uint8_t* buf, uint32_t* size, LoadReport* report);
+
+    /// Records a successfully prepared model: marks `body` as prepared (M2Init's version gate), keeps the
+    /// TXID list for `shared`, and updates the session counters / log.
+    void OnPrepared(const void* shared, const void* body, const LoadReport& report, const char* name);
+    /// Counts and logs a rejected container.
+    void OnRejected(const char* name, const LoadReport& report);
+    /// Drops everything remembered for a model. Safe on unknown pointers; the engine reuses addresses.
+    void Forget(const void* shared, const void* body);
+
+    /// True for a body PrepareContainer accepted (and Forget has not dropped since): M2Init may accept its version.
+    bool IsPreparedBody(const void* body);
+    /// True for a shared model that was loaded through the native reader.
+    bool IsModernModel(const void* shared);
+
+    /// FileDataID -> client path, supplied by whatever owns that database (wxl-db2 in the extension world).
+    /// The returned string must live for the whole process. Unset: hardcoded-texture ids simply don't resolve.
+    using FileDataIdResolver = const char* (*)(uint32_t fileDataId);
+    void SetFileDataIdResolver(FileDataIdResolver fn);
+
+    /**
+     * @brief Client path for a hardcoded texture the file names only by FileDataID (TXID), or nullptr.
+     *
+     * Replaces the extension's "point filename.offset at the resolved string": on x64 an M2Array offset is a
+     * self-relative int32, which cannot reach an arbitrary heap string, so CM2Shared::Initialize asks here.
+     */
+    const char* ResolveTextureName(const void* shared, uint32_t textureIndex);
+
+    Stats GetStats();
+}
