+        // free of any logging so it cannot recurse). Missing file, section or key: off.
+        bool IniEnabled()
+        {
+#ifdef _WIN32
+            char path[MAX_PATH] = {};
+            const DWORD n = GetModuleFileNameA(nullptr, path, sizeof(path));
