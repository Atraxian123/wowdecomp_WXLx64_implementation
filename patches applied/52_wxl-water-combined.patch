+}
+
+float2 ViewToNdcScale()
+{
+    return cViewToNdc.xy;
+}
+
+float2 ViewToNdcOffset()
+{
+    return cViewToNdc.zw;
+}
+
+float DepthAtInfiniteViewZ()
+{
+    return cDepthToViewZ.x;
+}
+
+float DepthPerInverseViewZ()
+{
