diff --git a/Engine/Source/WXLModules/Water/water_types.h b/Engine/Source/WXLModules/Water/water_types.h
new file mode 100644
index 0000000..28fad25
--- /dev/null
+++ b/Engine/Source/WXLModules/Water/water_types.h
@@ -0,0 +1,90 @@
+#pragma once
+
+#include <cstdint>
+
+enum class WaterClass : uint8_t
+{
+    None = 0,
+    Lake = 1,
+    River = 2,
+    Ocean = 3,
+    Interior = 4,
+};
+
+constexpr int kWaterClassCount = 5;
+constexpr int kWaterPresetTiles = 4;
+constexpr int kWaterMaxTiles = 8;
+constexpr int kWaterMaskSlots = 6;
+constexpr int32_t kWaterNoIndex = -1;
+
+constexpr uint32_t kForeverGenericLake = 1240;
+constexpr uint32_t kForeverGenericOcean = 1250;
+constexpr uint32_t kForeverGenericRiver = 1288;
+constexpr uint32_t kForeverWmoInterior = 1290;
+
+enum class WaterMaskSlot : int
+{
+    HighFoam = 0,
+    MidFoam = 1,
+    LowFoam = 2,
+    ShoreFoam = 3,
+    DepthFoam = 4,
+    RiverFoam = 5,
+};
+
+struct WaterFftTile
+{
+    uint32_t foreverTileId;
+    float size;
+    float amplitude;
+    float windMultiplier;
+    float windAlignment;
+    float foam[3];
+    float oxygen[3];
+};
+
+struct WaterPreset
+{
+    uint32_t foreverLiquidId;
+    float absorption[4];
+    float scatteringIntensities[4];
+    float scatteringTop[4];
+    float scatteringBottom[4];
+    float depthFadeFoam[4];
+    float shoreFoam[4];
+    float waveFoam[4];
+    float waveFoamScaling[4];
+    float flow[4];
+    float roughness[4];
+    int32_t tiles[kWaterPresetTiles];
+    int32_t masks[kWaterMaskSlots];
+};
+
+struct WaterMask
+{
+    uint32_t foreverFileDataId;
+    uint32_t size;
+    uint32_t mipCount;
+    float tintLow[3];
+    float tintHigh[3];
+};
+
+inline uint32_t ForeverLiquidOf(WaterClass waterClass)
+{
+    switch (waterClass)
+    {
+    case WaterClass::Lake:
+        return kForeverGenericLake;
+    case WaterClass::River:
+        return kForeverGenericRiver;
+    case WaterClass::Ocean:
+        // Ocean shares the lake preset so ocean water has the same properties as lake.
+        return kForeverGenericLake;
+    // Interior shares the lake preset so any residual interior-tagged draw has the
+    // same properties as lake water instead of a distinct interior surface.
+    case WaterClass::Interior:
+        return kForeverGenericLake;
+    default:
+        return 0;
+    }
+}
diff --git a/Engine/Source/WXLModules/Water/wxl-modern-water.ini b/Engine/Source/WXLModules/Water/wxl-modern-water.ini
new file mode 100644
index 0000000..e088b6f
--- /dev/null
+++ b/Engine/Source/WXLModules/Water/wxl-modern-water.ini
@@ -0,0 +1,59 @@
+; wxl-modern-water settings. Changes apply within a second while the game runs,
+; except Enable and EngineHooks, which need a client restart.
+[CoAVolFog]
+Enable=1
+EngineHooks=1
+
+; In-game settings window, shown and hidden with OverlayKey. It changes the settings below live; its Save button
+; writes the changed ones back to this file and keeps the comments. 0 = off (turning it on again needs a client
+; restart; with 0 at start-up the game window is left untouched)
+Overlay=1
+; F1-F24, Insert, Delete, Home, End, PageUp, PageDown, Pause, ScrollLock, a letter or a digit, with optional Ctrl+,
+; Shift+ and Alt+ in front
+OverlayKey=Ctrl+F7
+
+; 1 = keep the game's Multisampling video option (smoother edges) when the graphics driver can copy the
+; multisampled depth for the water: NVIDIA through NVAPI, AMD and Intel through RESZ. The copy is tested
+; when the game creates its display; if it fails, multisampling stays off and wxl-modern-water.log says why.
+Multisampling=1
+
+; Modern water: lakes, rivers, the sea and indoor pools are shaded like the modern client, with moving waves,
+; refraction, foam, sun highlights and reflections. Magma and slime keep the client's look. While modern water is
+; drawn (Water=1, waterdata.bin installed, camera above water), water surfaces write depth whatever LiquidDepth says.
+; 1 = on, 0 = the client's own water
+Water=1
+; 1 = low: 128 waves, sky reflections only; 2 = medium: 128 waves, scene reflections;
+; 3 = high: 256 waves, finer scene reflections
+WaterQuality=2
+; Wave height, 0..2; 0 = flat water
+WaterWaves=0.7
+; Wind that drives the waves, 0.5..10; stronger wind makes longer, rougher waves
+WaterWind=3.0
+; Foam on wave crests and along shores, 0..2; 0 = no foam
+WaterFoam=1.0
+; Reflections of the sky and the scene, 0..2; 0 = none
+WaterReflections=0.75
+; Highlight of the sun or moon on the water, 0..4; 0 = none
+WaterSpecular=1.0
+; How far you see into the water, 0.25..4; larger is clearer
+WaterClarity=0.7
+; How much the zone's own water colours (from the client's day and night lights) tint the water, 0..1;
+; 0 = the modern colours only
+WaterZoneColors=0.7
+; Ripples and wakes where players, creatures, pets and mounts move through or jump into water, 0..2: a unit
+; moving faster than the ripples spread (about 2.6 yd/s, a run or a swim) drags a thin V behind it, starting and
+; stopping each send out one ring, a splash marks jumping in, and a unit standing still leaves the water calm
+; with only a faint distortion at its feet. 0.5 is the default strength; 0 = none (no ripple simulation and no
+; reading of the units around you)
+WaterRipples=0.5
+; The client's own flat splash discs and white V-shaped wake trails: 0 = hidden while the modern water and its
+; ripples are drawn (the client's waterRipples console value is held at 0 and put back when they stop; they stay
+; when the ripples cannot run), 1 = keep them on top of the ripples. Hiding them is all or nothing: ripples reach
+; only about 24 yd around your character (10 yd at WaterQuality=1) and the 32 nearest units, and only on the
+; modern water, so a unit farther away or in a liquid the client draws itself leaves no wake while they are hidden
+WaterClientSplashes=0
+; 0 = off, 1 = wave normals, 2 = foam, 3 = transmittance, 4 = reflection, 5 = liquid class, 6 = ripples
+WaterDebugView=0
+
+; 0 = errors, 1 = info, 2 = debug
+LogLevel=1
