+
+constexpr uint32_t kMaxWaterContacts = 32;
+constexpr float kWaterContactRange = 48.0f;
+
+struct WaterContact
+{
+    uint64_t guid = 0;
+    float position[3] = {};
+    float surface = 0.0f;
+    float radius = 0.0f;
+    float height = 0.0f;
