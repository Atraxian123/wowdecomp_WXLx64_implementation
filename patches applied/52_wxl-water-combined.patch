+public:
+    explicit WrappedD3D9(IDirect3D9* real) : m_real(real)
+    {
+        void** vtable = *reinterpret_cast<void***>(real);
+        m_createDevice = reinterpret_cast<CreateDeviceRawFn>(vtable[kCreateDeviceSlot]);
