+																					   
+        if (!dstBuf || !srcBuf || remap.count == 0 || remap.count > 256)
+																
+															  
+																													
+																												 
+            return false;
+        __try
+        {
+            for (uint32_t bi = 0; bi < remap.count; ++bi)
+            {
+                uint8_t ci = remap.collToChar[bi];
+                if (ci == 0xFF) continue;
