+    static bool ParseU32(const char* text, uint32_t* out) noexcept
+    {
+        if (!text || !*text || !out) return false;
+        char* end = nullptr;
+        unsigned long value = std::strtoul(text, &end, 10);
+        if (end == text) return false;
+        *out = static_cast<uint32_t>(value);
+        return true;
+    }
