+WXL_MODULE_API int WxlModuleInit(const WxlApi* api, WxlModuleInfo* info)
+{
+    if (!api || api->abiVersion != WXL_ABI_VERSION || !WXL_API_HAS(api, getService)) return 1;
+    wxl::module::Bind(api);
+    if (info)
+    {
+        std::strncpy(info->name, "creature", sizeof(info->name) - 1);
+        info->versionMajor = 1;
