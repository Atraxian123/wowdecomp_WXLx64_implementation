diff --git a/Engine/Source/WXL/SpellAreaShapes.h b/Engine/Source/WXL/SpellAreaShapes.h
new file mode 100644
--- /dev/null
+++ b/Engine/Source/WXL/SpellAreaShapes.h
@@ -0,0 +1,92 @@
+// WXL spell area indicator: the parts that need no engine. See SpellArea.md.
+// Copyright (C) 2026 WarcraftXL (GPLv3, see Event.h)
+//
+// What shape a spell's effects cover (circle, cone, line, and where it is anchored), the override file that can
+// replace or add shapes per spell, and the textures the shapes are drawn with. Plain C++17, so it is tested on its own.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace wxl::spellarea
+{
+    enum class ShapeKind : uint8_t { Circle, Cone, Line };
+
+    /// Where a shape is centered: on the caster, or on the cast's destination (the ground point that was targeted, or
+    /// the target unit when the spell has no ground point).
+    enum class Anchor : uint8_t { Caster, Dest };
+
+    enum class Intent : uint8_t { Harmful, Helpful, Neutral };
+
+    struct Shape
+    {
+        ShapeKind kind   = ShapeKind::Circle;
+        Anchor    anchor = Anchor::Caster;
+        float     radius = 0;   // circle radius, cone radius, line length (yards)
+        float     param  = 0;   // cone angle in degrees, line width in yards
+        Intent    intent = Intent::Neutral;
+    };
+
+    /// The part of a spell record this needs: its three effects, the target types of each (Spell.dbc
+    /// ImplicitTargetA / B), and each effect's radius in yards (already worked out from SpellRadius.dbc and the
+    /// caster's level; 0 = no radius).
+    struct SpellEffects
+    {
+        int32_t effect[3]  = {};
+        int32_t targetA[3] = {};
+        int32_t targetB[3] = {};
+        float   radius[3]  = {};
+    };
+
+    struct ShapeRules
+    {
+        float coneAngle = 90.0f;   // degrees, for the cone target types (the DBC does not carry one)
+        float minRadius = 1.0f;    // a radius under this is not an area worth drawing
+        float maxRadius = 60.0f;   // a radius over this is drawn at this size
+        bool  cones     = true;
+    };
+
+    // ---- target type classes (3.3.5 Spell.dbc implicit target ids) ----
+    bool IsConeTarget(int32_t target);          // 24, 54, 59, 60, 104
+    bool IsCasterAreaTarget(int32_t target);    // areas around the caster: 7, 11, 15, 20, 30, 33, 56
+    bool IsDestAreaTarget(int32_t target);      // areas around the destination: 8, 16, 28, 29, 31, 34, 87, 91
+    bool IsEnemyTarget(int32_t target);
+    bool IsAllyTarget(int32_t target);
+
+    /// The areas a spell covers, from its effects: at most one per effect, equal ones merged. `out` has room for 3.
+    /// A cone target type gives a cone (angle from rules), an area around the caster or the destination gives a
+    /// circle, and so do the area aura effects (35, 65, 119, 128, 129, 143: around the caster) and the persistent area
+    /// aura (27: around the destination). Lines cannot be told from the DBC: they come from the override file.
+    size_t ShapesFromSpell(const SpellEffects& spell, const ShapeRules& rules, Shape out[3]);
+
+    // ---- override file ----
+    /// SpellAreaOverride.csv: `SpellId,Shape,Anchor,Radius,Param,Intent` (comma or semicolon; `#` starts a comment; a
+    /// header line is skipped). Shape: circle, cone, line, none. Anchor: caster, dest. Radius: circle radius, cone
+    /// radius or line length. Param: cone angle (degrees) or line width (yards). Intent: harmful, helpful, neutral.
+    /// Rows of one spell all apply; `none` hides the spell. A spell with rows uses them INSTEAD of what its effects say.
+    class OverrideTable
+    {
+    public:
+        /// Parses `text`; a bad line is skipped and described in `problems` (one line each).
+        void Parse(const std::string& text, std::string& problems);
+        /// true when the spell has rows. `none` is set when it is hidden; otherwise `shapes` holds its rows.
+        bool Find(uint32_t spellId, bool& none, std::vector<Shape>& shapes) const;
+        size_t Rows() const { return m_rows.size(); }
+
+    private:
+        struct Row { uint32_t spell; bool none; Shape shape; };
+        std::vector<Row> m_rows;
+    };
+
+    /// "RRGGBB" or "#RRGGBB" to 0..1 floats; false when it is not six hex digits.
+    bool ParseColorHex(const char* text, float rgb[3]);
+
+    // ---- textures: ARGB8888 (0xAARRGGBB), white with the shape in the alpha channel, row 0 = the shape's front ----
+    void RenderCircleTexture(std::vector<uint32_t>& argb, int size);
+    /// a cone with its apex at the center of the texture, opening toward row 0, `angleDeg` wide (up to 180)
+    void RenderConeTexture(std::vector<uint32_t>& argb, int size, float angleDeg);
+    /// a strip from the center of the texture to row 0, `widthFraction` of the texture wide (0..1)
+    void RenderLineTexture(std::vector<uint32_t>& argb, int size, float widthFraction);
+}
diff --git a/Engine/Source/WXL/SpellAreaShapes.cpp b/Engine/Source/WXL/SpellAreaShapes.cpp
new file mode 100644
--- /dev/null
+++ b/Engine/Source/WXL/SpellAreaShapes.cpp
@@ -0,0 +1,275 @@
+// WXL spell area indicator: shape rules, override file, textures. See SpellAreaShapes.h.
+// Copyright (C) 2026 WarcraftXL (GPLv3, see Event.h)
+
+#include "Engine/Source/WXL/SpellAreaShapes.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace wxl::spellarea
+{
+    namespace
+    {
+        bool InSet(int32_t v, const int32_t* set, size_t n)
+        {
+            for (size_t i = 0; i < n; ++i)
+                if (set[i] == v) return true;
+            return false;
+        }
+        template <size_t N> bool In(int32_t v, const int32_t (&set)[N]) { return InSet(v, set, N); }
+
+        std::string Trim(const std::string& s)
+        {
+            size_t a = 0, b = s.size();
+            while (a < b && std::isspace(static_cast<unsigned char>(s[a]))) ++a;
+            while (b > a && std::isspace(static_cast<unsigned char>(s[b - 1]))) --b;
+            return s.substr(a, b - a);
+        }
+
+        std::string Lower(std::string s)
+        {
+            for (char& c : s) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+            return s;
+        }
+
+        bool ParseFloat(const std::string& s, float& out)
+        {
+            std::string t = s;
+            for (char& c : t) if (c == ',') c = '.';   // never reached with a comma separator, kept for ';' files
+            char* end = nullptr;
+            const double v = std::strtod(t.c_str(), &end);
+            if (end == t.c_str() || !std::isfinite(v)) return false;
+            out = static_cast<float>(v);
+            return true;
+        }
+
+        float Smooth(float x) { x = std::max(0.0f, std::min(1.0f, x)); return x * x * (3.0f - 2.0f * x); }
+
+        // alpha of a shape drawn as a translucent fill with a bright outline, from the signed distance to its border
+        // (positive inside, in texture units)
+        float ShapeAlpha(float signedDist, float pixel)
+        {
+            const float fill = 0.24f * Smooth(0.5f + signedDist / pixel);
+            const float ringHalf = 0.0125f;
+            const float ring = 1.0f - Smooth((std::fabs(signedDist) - ringHalf) / pixel + 0.5f);
+            return std::max(fill, ring);
+        }
+
+        uint32_t PackWhite(float alpha)
+        {
+            const uint32_t a = static_cast<uint32_t>(std::max(0.0f, std::min(1.0f, alpha)) * 255.0f + 0.5f);
+            return (a << 24) | 0x00FFFFFFu;
+        }
+    }
+
+    bool IsConeTarget(int32_t t)         { static const int32_t s[] = { 24, 54, 59, 60, 104 }; return In(t, s); }
+    bool IsCasterAreaTarget(int32_t t)   { static const int32_t s[] = { 7, 11, 15, 20, 30, 33, 56 }; return In(t, s); }
+    bool IsDestAreaTarget(int32_t t)     { static const int32_t s[] = { 8, 16, 28, 29, 31, 34, 87, 91 }; return In(t, s); }
+    bool IsEnemyTarget(int32_t t)        { static const int32_t s[] = { 2, 6, 15, 16, 24, 28, 53, 54, 104, 93 }; return In(t, s); }
+    bool IsAllyTarget(int32_t t)         { static const int32_t s[] = { 3, 4, 20, 21, 29, 30, 31, 33, 34, 35, 56, 57, 58, 59, 45, 37 }; return In(t, s); }
+
+    size_t ShapesFromSpell(const SpellEffects& spell, const ShapeRules& rules, Shape out[3])
+    {
+        static const int32_t kAreaAuraCaster[] = { 35, 65, 119, 128, 129, 143 };
+        static const int32_t kAreaAuraHelpful[] = { 35, 65, 119, 128, 143 };
+
+        size_t n = 0;
+        for (int i = 0; i < 3; ++i)
+        {
+            if (!spell.effect[i]) continue;
+            float r = spell.radius[i];
+            if (!(r >= rules.minRadius)) continue;
+            r = std::min(r, rules.maxRadius);
+
+            const int32_t a = spell.targetA[i], b = spell.targetB[i], eff = spell.effect[i];
+            const bool cone = IsConeTarget(a) || IsConeTarget(b);
+            bool casterArea = IsCasterAreaTarget(a) || IsCasterAreaTarget(b);
+            bool destArea = IsDestAreaTarget(a) || IsDestAreaTarget(b);
+            if (!cone && !casterArea && !destArea)
+            {
+                if (In(eff, kAreaAuraCaster)) casterArea = true;
+                else if (eff == 27) destArea = true;       // persistent area aura: the area is at the destination
+            }
+            if (!cone && !casterArea && !destArea) continue;
+            if (cone && !rules.cones) continue;
+
+            Shape s;
+            s.radius = r;
+            if (cone)            { s.kind = ShapeKind::Cone; s.anchor = Anchor::Caster; s.param = rules.coneAngle; }
+            else if (casterArea) { s.kind = ShapeKind::Circle; s.anchor = Anchor::Caster; }
+            else                 { s.kind = ShapeKind::Circle; s.anchor = Anchor::Dest; }
+
+            if (IsEnemyTarget(a) || IsEnemyTarget(b) || eff == 129) s.intent = Intent::Harmful;
+            else if (IsAllyTarget(a) || IsAllyTarget(b) || In(eff, kAreaAuraHelpful)) s.intent = Intent::Helpful;
+            else s.intent = Intent::Neutral;
+
+            bool dup = false;
+            for (size_t k = 0; k < n; ++k)
+                if (out[k].kind == s.kind && out[k].anchor == s.anchor && std::fabs(out[k].radius - s.radius) < 0.01f)
+                {
+                    // a damaging effect and a helpful one on the same spot: the damage is what to be careful about
+                    if (s.intent == Intent::Harmful) out[k].intent = Intent::Harmful;
+                    dup = true;
+                    break;
+                }
+            if (!dup) out[n++] = s;
+        }
+        return n;
+    }
+
+    void OverrideTable::Parse(const std::string& text, std::string& problems)
+    {
+        m_rows.clear();
+        size_t pos = 0;
+        int lineNo = 0;
+        while (pos <= text.size())
+        {
+            size_t eol = text.find('\n', pos);
+            if (eol == std::string::npos) eol = text.size();
+            std::string line = text.substr(pos, eol - pos);
+            pos = eol + 1;
+            ++lineNo;
+
+            if (!line.empty() && line.back() == '\r') line.pop_back();
+            line = Trim(line);
+            if (line.empty() || line[0] == '#') continue;
+
+            const char sep = line.find(';') != std::string::npos ? ';' : ',';
+            std::vector<std::string> cells;
+            size_t a = 0;
+            for (;;)
+            {
+                const size_t b = line.find(sep, a);
+                cells.push_back(Trim(line.substr(a, b == std::string::npos ? std::string::npos : b - a)));
+                if (b == std::string::npos) break;
+                a = b + 1;
+            }
+
+            char* end = nullptr;
+            const unsigned long id = std::strtoul(cells[0].c_str(), &end, 10);
+            if (cells[0].empty() || *end != '\0')
+            {
+                if (lineNo != 1 && !Lower(cells[0]).starts_with("spell"))
+                    problems += "line " + std::to_string(lineNo) + ": the spell id '" + cells[0] + "' is not a number; skipped\n";
+                continue;   // the header line, or a bad one
+            }
+
+            Row row{};
+            row.spell = static_cast<uint32_t>(id);
+            const std::string shape = cells.size() > 1 ? Lower(cells[1]) : "";
+            if (shape == "none") { row.none = true; m_rows.push_back(row); continue; }
+
+            if (shape == "circle") row.shape.kind = ShapeKind::Circle;
+            else if (shape == "cone") row.shape.kind = ShapeKind::Cone;
+            else if (shape == "line") row.shape.kind = ShapeKind::Line;
+            else { problems += "line " + std::to_string(lineNo) + ": shape '" + shape + "' is not circle, cone, line or none; skipped\n"; continue; }
+
+            const std::string anchor = cells.size() > 2 ? Lower(cells[2]) : "";
+            row.shape.anchor = (anchor == "dest" || anchor == "destination") && row.shape.kind == ShapeKind::Circle ? Anchor::Dest : Anchor::Caster;
+
+            float radius = 0;
+            if (cells.size() < 4 || !ParseFloat(cells[3], radius) || radius <= 0)
+            {
+                problems += "line " + std::to_string(lineNo) + ": the radius / length is missing or not above 0; skipped\n";
+                continue;
+            }
+            row.shape.radius = radius;
+
+            float param = row.shape.kind == ShapeKind::Cone ? 90.0f : 4.0f;
+            if (cells.size() > 4 && !cells[4].empty() && !ParseFloat(cells[4], param))
+            {
+                problems += "line " + std::to_string(lineNo) + ": the angle / width '" + cells[4] + "' is not a number; skipped\n";
+                continue;
+            }
+            row.shape.param = param;
+
+            const std::string intent = cells.size() > 5 ? Lower(cells[5]) : "";
+            row.shape.intent = intent == "harmful" ? Intent::Harmful : intent == "helpful" ? Intent::Helpful : Intent::Neutral;
+            m_rows.push_back(row);
+        }
+    }
+
+    bool OverrideTable::Find(uint32_t spellId, bool& none, std::vector<Shape>& shapes) const
+    {
+        none = false;
+        shapes.clear();
+        bool found = false;
+        for (const Row& r : m_rows)
+        {
+            if (r.spell != spellId) continue;
+            found = true;
+            if (r.none) none = true;
+            else shapes.push_back(r.shape);
+        }
+        if (none) shapes.clear();
+        return found;
+    }
+
+    bool ParseColorHex(const char* text, float rgb[3])
+    {
+        if (!text) return false;
+        if (*text == '#') ++text;
+        if (std::strlen(text) < 6) return false;
+        unsigned v[3] = {};
+        for (int i = 0; i < 6; ++i)
+            if (!std::isxdigit(static_cast<unsigned char>(text[i]))) return false;
+        if (std::sscanf(text, "%2x%2x%2x", &v[0], &v[1], &v[2]) != 3) return false;
+        for (int i = 0; i < 3; ++i) rgb[i] = static_cast<float>(v[i]) / 255.0f;
+        return true;
+    }
+
+    void RenderCircleTexture(std::vector<uint32_t>& argb, int size)
+    {
+        argb.assign(static_cast<size_t>(size) * size, 0);
+        const float pixel = 1.0f / static_cast<float>(size);
+        const float R = 0.485f;
+        for (int row = 0; row < size; ++row)
+            for (int col = 0; col < size; ++col)
+            {
+                const float x = (col + 0.5f) * pixel - 0.5f, y = 0.5f - (row + 0.5f) * pixel;
+                argb[static_cast<size_t>(row) * size + col] = PackWhite(ShapeAlpha(R - std::sqrt(x * x + y * y), pixel));
+            }
+    }
+
+    void RenderConeTexture(std::vector<uint32_t>& argb, int size, float angleDeg)
+    {
+        argb.assign(static_cast<size_t>(size) * size, 0);
+        const float pixel = 1.0f / static_cast<float>(size);
+        const float R = 0.485f;
+        const float kPi = 3.14159265358979f;
+        const float half = std::max(1.0f, std::min(180.0f, angleDeg)) * 0.5f * kPi / 180.0f;
+        for (int row = 0; row < size; ++row)
+            for (int col = 0; col < size; ++col)
+            {
+                const float x = (col + 0.5f) * pixel - 0.5f, y = 0.5f - (row + 0.5f) * pixel;
+                const float r = std::sqrt(x * x + y * y);
+                const float theta = std::atan2(std::fabs(x), y);      // angle from the front, 0..pi
+                float edge;                                           // signed distance to the straight sides
+                if (theta <= half) edge = r * std::sin(half - theta);
+                else if (theta - half > kPi * 0.5f) edge = -r;        // behind the apex: far from both sides
+                else edge = r * std::sin(half - theta);
+                const float d = std::min(R - r, edge);
+                argb[static_cast<size_t>(row) * size + col] = PackWhite(ShapeAlpha(d, pixel));
+            }
+    }
+
+    void RenderLineTexture(std::vector<uint32_t>& argb, int size, float widthFraction)
+    {
+        argb.assign(static_cast<size_t>(size) * size, 0);
+        const float pixel = 1.0f / static_cast<float>(size);
+        const float halfW = std::max(pixel * 2.0f, std::min(1.0f, widthFraction)) * 0.5f;
+        const float top = 0.485f;
+        for (int row = 0; row < size; ++row)
+            for (int col = 0; col < size; ++col)
+            {
+                const float x = (col + 0.5f) * pixel - 0.5f, y = 0.5f - (row + 0.5f) * pixel;
+                const float dx = halfW - std::fabs(x);
+                const float dy = std::min(y, top - y);
+                argb[static_cast<size_t>(row) * size + col] = PackWhite(ShapeAlpha(std::min(dx, dy), pixel));
+            }
+    }
+}
diff --git a/Engine/Source/WXL/SpellArea.md b/Engine/Source/WXL/SpellArea.md
new file mode 100644
--- /dev/null
+++ b/Engine/Source/WXL/SpellArea.md
@@ -0,0 +1,101 @@
+# Spell area indicator
+
+Draws the ground area of spells as colored, terrain-hugging shapes: while a spell is **being cast** (the precast),
+while it is **channeled**, and for as long as it **lies on the ground** (Blizzard, Flamestrike, Consecration, Death and
+Decay, Rain of Fire ...). Circles, cones and lines. Off by default; part of the client, no module DLL.
+
+It uses the client's own projected-texture pass, the one that paints the targeting circle under the cursor, so the
+shapes follow terrain, WMOs and doodads and show over water. The client's circle while you aim is untouched.
+
+## Turning it on
+
+```ini
+[SpellArea]
+Enabled=1
+```
+
+The ini is looked at once a second: save it and the indicator switches on or off, and picks up the other keys, without
+restarting.
+
+## Keys (all optional)
+
+```ini
+[SpellArea]
+Enabled=1
+Own=1                   ; your own spells
+Others=0                ; everybody else's too (an enemy casting an area spell shows where it will land)
+Precast=1               ; the area of a spell being cast
+Channel=1               ; the area of a spell being channeled (Hellfire, Tranquility, ...)
+Persistent=1            ; areas lying on the ground (the game's dynamic objects)
+Cones=1                 ; cone spells
+Opacity=0.65            ; 0.05 .. 1
+HarmfulColor=FF3C28     ; RRGGBB: areas that hurt (enemy area targets)
+HelpfulColor=3CFF5A     ; areas that help (party, raid, ally area targets, area auras)
+NeutralColor=FFC83C     ; the rest
+ConeAngle=90            ; degrees, for cone spells (the spell data does not carry one)
+MinRadius=1.0           ; smaller areas are not drawn
+MaxRadius=60            ; bigger ones are drawn at this size
+MaxAreas=16             ; at most this many shapes at once
+OverrideFile=SpellAreaOverride.csv
+```
+
+## What is drawn, and where it comes from
+
+| situation | shape | placed on |
+|---|---|---|
+| a ground-targeted spell with a cast time (Flamestrike, Mass Dispel) | circle, fading in as the cast goes on | the ground point you aimed at |
+| a spell around the caster being cast or channeled (Arcane Explosion, Hellfire) | circle | the caster, following it |
+| a spell on a target (area around the target unit) | circle | the target unit |
+| a channel's area aura (Tranquility, Divine Hymn ...) | circle | the caster |
+| a cone spell (Cone of Cold, Dragon's Breath ...) | cone, 90 degrees by default | the caster, turning with it |
+| anything lying on the ground (Blizzard, Consecration, Death and Decay, Rain of Fire, Volley, ground effects of bosses) | circle of its real radius | the game's dynamic object, for as long as it exists |
+
+The size is the spell's own radius from the client data, worked out for the caster's level, and for **your** spells
+with your talents' and auras' radius modifiers (the same ones the targeting circle uses). The color says what the spell
+does: red for the areas that hit enemies, green for the ones that help friends, amber otherwise; an enemy's dynamic
+object is always red.
+
+When a dynamic object of a spell exists, it is the one that is drawn (its radius is the truth), so Blizzard shows one
+circle, not two.
+
+## Lines, odd cones, hiding a spell: SpellAreaOverride.csv
+
+The spell data has no line shape and no cone angle, and a few spells have an area that is not in it. A file beside the
+client executable fixes that, spell by spell. It is read again when saved.
+
+```csv
+SpellId,Shape,Anchor,Radius,Param,Intent
+# a line 40 yards long and 6 wide in front of the caster
+12345,line,caster,40,6,harmful
+# a cone of 60 degrees and 25 yards
+23456,cone,caster,25,60,harmful
+# a circle of 8 yards on the aimed point
+34567,circle,dest,8,,harmful
+# never draw this one
+45678,none
+```
+
+* `Shape`: `circle`, `cone`, `line` or `none`. `Anchor`: `caster` or `dest` (circles only; cones and lines always start at
+  the caster and point where it faces). `Radius`: circle radius, cone radius or line length in yards. `Param`: cone
+  angle in degrees, or line width in yards. `Intent`: `harmful`, `helpful` or `neutral` (the color).
+* Several rows of one spell all apply. A spell that has rows uses **only** them, not what its data says.
+* Comma or semicolon separated; `#` starts a comment; a header line is skipped. A bad line is skipped and written to
+  `WXL.log` (category AOE, needs `[Log] Enabled=1`).
+
+## Limits
+
+* Area traps and other game objects (Explosive Trap, a placed totem's radius) are not drawn: they are objects, not
+  spell areas. Totem and aura radii that are not channels are not drawn either.
+* The cone angle is one value for all cone spells unless a row says otherwise.
+* Shapes are placed on the cast's destination as the server sent it; a spell the server aims differently from its
+  data will be off.
+* Up to `MaxAreas` shapes at once, each costs a terrain query: very many large areas (a raid fight with `Others=1`)
+  can cost frames. `MaxRadius` and `MaxAreas` bound it.
+
+## Where the code is
+
+* `Engine/Source/WXL/SpellAreaShapes.*`: what a spell covers (target types to shapes), the override file, the shape
+  textures. No engine dependency, tested by `Tools/WxlModuleTest/run_spell_area_tests.sh`.
+* `Engine/Source/WXLApi/SpellArea.*`: collects the casts, channels and dynamic objects, and draws.
+* `WorldFrame.cpp`: two `wxl::spellarea::Render` calls beside the client's own cursor shadow.
+* `Spell_C.cpp`: `Spell_C_WxlFindPendingCast`, the targets of a cast in progress.
