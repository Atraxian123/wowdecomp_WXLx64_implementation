diff --git a/Engine/Source/WXLModules/Equip/CMakeLists.txt b/Engine/Source/WXLModules/Equip/CMakeLists.txt
new file mode 100644
index 0000000..5b6bf58
--- /dev/null
+++ b/Engine/Source/WXLModules/Equip/CMakeLists.txt
@@ -0,0 +1,23 @@
+# WXL equip module: wxl_equip.dll, loaded from <client folder>\WXL\Modules\ by the 64-bit client.
+# Built against Engine/Source/WXL/Sdk (wxl_api.h, wxl_module.hpp) and its own folder only.
+if (NOT WOWDECOMP_ARCH_64)
+    message(STATUS "WXL modules are 64-bit only: wxl_equip is not built")
+    return()
+endif ()
+
+file(GLOB MODULE_SOURCES CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/*.cpp")
+
+add_library(wxl_equip SHARED ${MODULE_SOURCES})
+
+target_include_directories(wxl_equip
+    PRIVATE
+        ${CMAKE_CURRENT_SOURCE_DIR}
+        ${CMAKE_SOURCE_DIR}/Engine/Source/WXL/Sdk
+)
+
+set_target_properties(wxl_equip PROPERTIES
+    PREFIX ""
+    CXX_VISIBILITY_PRESET hidden
+    VISIBILITY_INLINES_HIDDEN ON
+    RUNTIME_OUTPUT_DIRECTORY "$<1:${CMAKE_SOURCE_DIR}/bin/Win/WXL/Modules>"
+)
