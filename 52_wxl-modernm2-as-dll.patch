diff --git a/Engine/Source/WXLModules/ModernM2/M2Records.hpp b/Engine/Source/WXLModules/ModernM2/M2Records.hpp
new file mode 100644
index 0000000..d231d68
--- /dev/null
+++ b/Engine/Source/WXLModules/ModernM2/M2Records.hpp
@@ -0,0 +1,383 @@
+// The client's M2 record layout, as the modern M2 module sees it.
+// Copyright (C) 2026 WarcraftXL (GPLv3, see Engine/Source/WXL/Event.h)
+//
+// A copy of Engine/Source/Model2/M2Data.h with the Tempest vector types reduced to their fields: a module includes no
+// engine header (Sdk/wxl_api.h), so it carries the layout it reads. The layout is the 3.3.5a client's record format
+// and does not change; Tools/WxlModuleTest/modernm2_layout_test.cpp compares every size and offset below with the
+// engine's own M2Data.h, so a drift fails the test instead of corrupting a model.
+//
+// Everything lives in wxl::m2rec so the module never collides with the client's global names when both are compiled
+// into one test program. Names, member names and offsets are the engine's.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace wxl::m2rec
+{
+    struct C2Vector { float x, y; };
+    struct C3Vector { float x, y, z; };
+    struct C4Quaternion { float x, y, z, w; };
+    struct CAaBox { C3Vector b, t; };
+    struct CRange { float m_l, m_h; };
+    struct CiRange { int32_t m_l, m_h; };
+
+
+    template <class T>
+    class M2Array {
+        public:
+        /* 0000 */ uint32_t m_count;
+        /* 0004 */ uint32_t m_offset;
+
+        T& operator[](uint32_t index) const { return Data()[index]; }
+        /// The data sits at a signed 32-bit offset from the array record itself.
+        T* Data() const
+        {
+            return reinterpret_cast<T*>(reinterpret_cast<uintptr_t>(this) + static_cast<intptr_t>(static_cast<int32_t>(m_offset)));
+        }
+        void Set(const T* data)
+        {
+            m_offset = data ? static_cast<uint32_t>(reinterpret_cast<uintptr_t>(data) - reinterpret_cast<uintptr_t>(this)) : 0;
+        }
+    };
+
+    class fixed16 {
+        public:
+        /* 0000 */ int16_t m_value;
+
+    };
+
+    class ubyte4 {
+        public:
+        /* 0000 */ uint8_t b [4];
+
+        uint8_t operator[](uint32_t index) const { return b[index]; }
+    };
+
+    template <class T>
+    class M2SplineKey {
+        public:
+        /* 0000 */ T m_value;
+        T m_inTan;
+        T m_outTan;
+    };
+
+    class M2CompQuat {
+        public:
+        /* 0000 */ uint16_t m_values [4];
+    };
+
+    class M2TrackBase {
+        public:
+        /* 0000 */ uint16_t m_trackType;
+        /* 0002 */ uint16_t m_loopIndex;
+        /* 0004 */ M2Array<M2Array<uint32_t> > m_sequenceTimes;
+    };
+
+    template <class T>
+    class M2Track : public M2TrackBase {
+        public:
+        /* 000C */ M2Array<M2Array<T> > m_sequenceKeys;
+    };
+
+    template <class T>
+    class M2PartTrack {
+        public:
+        /* 0000 */ M2Array<fixed16> m_times;
+        /* 0008 */ M2Array<T> m_values;
+    };
+
+    class M2Bounds {
+        public:
+        /* 0000 */ CAaBox m_extent;
+        /* 0018 */ float m_radius;
+    };
+
+    class M2Loop {
+        public:
+        /* 0000 */ uint32_t m_length;
+    };
+
+    class M2Sequence {
+        public:
+        /* 0000 */ uint16_t m_id;
+        /* 0002 */ uint16_t m_variationIndex;
+        /* 0004 */ uint32_t m_duration;
+        /* 0008 */ float m_moveSpeed;
+        /* 000C */ uint32_t m_flags;
+        /* 0010 */ uint32_t m_frequency;
+        /* 0014 */ CiRange m_replay;
+        /* 001C */ uint32_t m_blendTime;
+        /* 0020 */ M2Bounds m_bounds;
+        /* 003C */ uint16_t m_variationNext;
+        /* 003E */ uint16_t m_aliasNext;
+    };
+
+    class M2CompBone {
+        public:
+        /* 0000 */ uint32_t m_boneId;
+        /* 0004 */ uint32_t m_flags;
