+++ b/Engine/Source/WXLApi/ModelAccess.cpp
@@ -0,0 +1,125 @@
+// Guarded reads of the engine's model instances. See ModelAccess.h.
+// Copyright (C) 2026 WarcraftXL (GPLv3, see Engine/Source/WXL/Event.h)
+//
+// What this does is what the in-tree physics glue did before it became a module: copy an instance's inputs out
+// of client memory in guarded steps, report the step that failed, and write a bone palette back the same way.
+//   * bone world = palette bone x the scene matrix (CM2Scene::m_viewInv, a MIRROR: handed over as 16 floats);
+//   * the placement is the instance's own matrix (CM2Model::m_matrixF4);
+//   * the clock is the scene's (CM2Scene::m_time, ms).
+
+#include "Engine/Source/WXLApi/ModelAccess.h"
+
+#include "Engine/Source/Model2/M2Data.h"
+#include "Engine/Source/Model2/M2Model.h"
+#include "Engine/Source/Model2/M2Scene.h"
+#include "Engine/Source/Model2/M2Shared.h"
+
+#include <windows.h>
+
+#include <cstring>
+
+namespace wxl::api::model
+{
+    static_assert(sizeof(C44Matrix) == 64, "the bone palette and the matrices are 16 floats");
+
+    namespace
+    {
+        // No C++ objects in a function with __try, so every guarded copy is its own tiny function.
+        bool SafeCopy(void* dst, const void* src, size_t n) noexcept
+        {
+            __try { std::memcpy(dst, src, n); return true; }
+            __except (EXCEPTION_EXECUTE_HANDLER) { return false; }
+        }
+
+        struct Resolved
+        {
+            const CM2Model*   model = nullptr;
+            CM2Shared*        shared = nullptr;
+            const CM2Scene*   scene = nullptr;
+            const C44Matrix*  palette = nullptr;    // the instance's live palette
+            const M2CompBone* bones = nullptr;      // the model's bone records
+            uint32_t          boneCount = 0;
+            char              path[WXL_PATH_MAX] = {};
+        };
+
+        // Stops at the first step that does not hold and returns its WXL_READ_* code.
+        int Resolve(void* instance, Resolved& r) noexcept
+        {
+            r.model = static_cast<const CM2Model*>(instance);
+            if (!r.model) return WXL_READ_NO_MODEL;
+            const M2Data* hdr = nullptr;
+            uint32_t sharedFlags = 0, instFlags = 0;
+
+            if (!SafeCopy(&r.shared, &r.model->m_shared, sizeof(r.shared)) || !r.shared) return WXL_READ_NO_MODEL;
+            if (!SafeCopy(r.path, r.shared->m_fileName, sizeof(r.path) - 1)) { r.path[0] = 0; return WXL_READ_NO_PATH; }
+            r.path[sizeof(r.path) - 1] = 0;
+            // The model must be fully loaded AND parsed: before that bit is set the header's arrays are not
+            // relocated, and Data() points at garbage.
+            if (!SafeCopy(&sharedFlags, &r.shared->m_flags, 4) || !(sharedFlags & 1u)) return WXL_READ_NOT_PARSED;
+            if (!SafeCopy(&hdr, &r.shared->m_data, sizeof(hdr)) || !hdr) return WXL_READ_NO_HEADER;
+            if (!SafeCopy(&r.boneCount, &hdr->m_bones.m_count, 4)) return WXL_READ_NO_BONE_COUNT;
+            if (r.boneCount < 2 || r.boneCount > WXL_MAX_BONES) return WXL_READ_BONE_COUNT;   // one bone: nothing can swing
+            if (!SafeCopy(&instFlags, &r.model->m_fFlags, 4) || !(instFlags & 1u)) return WXL_READ_NOT_ANIMATED;
+            if (!SafeCopy(&r.scene, &r.model->m_scene, sizeof(r.scene)) || !r.scene) return WXL_READ_NO_SCENE;
+            if (!SafeCopy(&r.palette, &r.model->m_boneMatrices, sizeof(r.palette)) || !r.palette) return WXL_READ_NO_PALETTE;
+            r.bones = hdr->m_bones.Data();
+            if (!r.bones) return WXL_READ_NO_BONES;
+            return WXL_READ_OK;
+        }
+    }
+
+    int ReadInstance(void* instance, WxlInstanceView* out)
+    {
+        if (!out || out->structSize < sizeof(WxlInstanceView)) return WXL_READ_NO_MODEL;
+        Resolved r;
+        const int stage = Resolve(instance, r);
+        // the path and the model id are worth having even when a later step failed (the module logs them)
+        std::memcpy(out->path, r.path, sizeof(out->path));
+        out->model = r.shared;
+        out->boneCount = r.boneCount;
+        if (stage) return stage;
+
+        if (!SafeCopy(&out->clockMs, &r.scene->m_time, 4)) return WXL_READ_NO_CLOCK;
+        if (!SafeCopy(out->sceneMatrix, &r.scene->m_viewInv, sizeof(out->sceneMatrix))) return WXL_READ_NO_SCENE_MAT;
+        if (!SafeCopy(out->ownMatrix, &r.model->m_matrixF4, sizeof(out->ownMatrix))) return WXL_READ_NO_OWN_MAT;
+        return WXL_READ_OK;
+    }
+
+    int ReadBones(void* instance, uint32_t count, float* palette, int16_t* parents, float* pivots)
+    {
+        Resolved r;
+        const int stage = Resolve(instance, r);
+        if (stage) return stage;
+        if (count != r.boneCount) return WXL_READ_BONE_COUNT;
+
+        if (palette && !SafeCopy(palette, r.palette, size_t(count) * 64)) return WXL_READ_NO_PALETTE;
+        if (parents || pivots)
+        {
+            for (uint32_t k = 0; k < count; ++k)
+            {
+                uint16_t parent = 0xFFFF;
+                C3Vector pivot{};
+                if (!SafeCopy(&parent, &r.bones[k].m_parentIndex, 2)) return WXL_READ_NO_BONES;
+                if (!SafeCopy(&pivot, &r.bones[k].m_pivot, sizeof(pivot))) return WXL_READ_NO_BONES;
+                if (parents) parents[k] = static_cast<int16_t>(parent);   // 0xFFFF = no parent, as the engine reads it
+                if (pivots)
+                {
+                    pivots[k * 3 + 0] = pivot.x;
+                    pivots[k * 3 + 1] = pivot.y;
+                    pivots[k * 3 + 2] = pivot.z;
+                }
+            }
+        }
+        return WXL_READ_OK;
+    }
+
+    int WritePalette(void* instance, const float* palette, uint32_t count)
+    {
+        if (!palette) return WXL_READ_NO_PALETTE;
+        Resolved r;
+        const int stage = Resolve(instance, r);
+        if (stage) return stage;
+        if (count != r.boneCount) return WXL_READ_BONE_COUNT;
+        return SafeCopy(const_cast<C44Matrix*>(r.palette), palette, size_t(count) * 64) ? WXL_READ_OK : WXL_READ_NO_PALETTE;
+    }
+}
diff --git a/Engine/Source/WXLApi/ModelAccess.h b/Engine/Source/WXLApi/ModelAccess.h
new file mode 100644
index 0000000..9cc7271
--- /dev/null
+++ b/Engine/Source/WXLApi/ModelAccess.h
@@ -0,0 +1,16 @@
+// Guarded reads of the engine's model instances, behind WxlApi::readInstance / readBones / writePalette.
+// Copyright (C) 2026 WarcraftXL (GPLv3, see Engine/Source/WXL/Event.h)
+//
+// The only file of the module API that knows what a CM2Model is. A module never sees these types: it gets
+// plain numbers, and every read of client memory is done here under SEH, so a stale instance costs one frame
+// of one module, not the client.
+#pragma once
+
+#include "Engine/Source/WXL/Sdk/wxl_api.h"
+
+namespace wxl::api::model
+{
+    int ReadInstance(void* instance, WxlInstanceView* out);
+    int ReadBones(void* instance, uint32_t count, float* palette, int16_t* parents, float* pivots);
+    int WritePalette(void* instance, const float* palette, uint32_t count);
+}
diff --git a/Engine/Source/WXLApi/ModuleLoader.cpp b/Engine/Source/WXLApi/ModuleLoader.cpp
new file mode 100644
index 0000000..6e08589
--- /dev/null
+++ b/Engine/Source/WXLApi/ModuleLoader.cpp
@@ -0,0 +1,291 @@
+// Finds and loads WXL\Modules\*.dll. See ApiHost.h.
+// Copyright (C) 2026 WarcraftXL (GPLv3, see Engine/Source/WXL/Event.h)
+//
+// 64-bit client only: the module API is defined for 64-bit DLLs, and a 32-bit build neither loads nor looks
+// for any. Nothing here touches the engine; it needs the log, the ini helpers and the API table.
+
+#include "Engine/Source/WXLApi/ApiHost.h"
+
+#include "Engine/Source/WXL/Log.h"
+#include "Engine/Source/WXLEquip/VirtualPath.hpp"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#if defined(_WIN32)
+#include <windows.h>
+#endif
+
+namespace wxl::api
+{
+#if defined(_WIN32) && defined(WOWDECOMP_ARCH_64)
+
+    namespace
+    {
+        namespace eq = wxl::scripts::equipextension;
+
+        struct Loaded
+        {
+            ModuleStatus     status;
+            HMODULE          dll = nullptr;
+            WxlModuleShutdownFn shutdown = nullptr;
+        };
+
+        std::mutex           g_lock;
+        std::vector<Loaded>  g_modules;
+        bool                 g_done = false;
+
+        std::string Narrow(const std::wstring& w)
+        {
+            if (w.empty()) return {};
+            const int n = WideCharToMultiByte(CP_UTF8, 0, w.data(), static_cast<int>(w.size()), nullptr, 0, nullptr, nullptr);
+            std::string s(static_cast<size_t>(n), '\0');
+            WideCharToMultiByte(CP_UTF8, 0, w.data(), static_cast<int>(w.size()), s.data(), n, nullptr, nullptr);
+            return s;
+        }
+
+        std::string Lower(std::string s)
+        {
+            for (char& c : s) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+            return s;
+        }
+
+        // The folder the client runs from, with a trailing backslash.
+        std::wstring ExeFolder()
+        {
+            wchar_t path[MAX_PATH] = {};
+            const DWORD n = GetModuleFileNameW(nullptr, path, MAX_PATH);
+            if (n == 0 || n >= MAX_PATH) return {};
+            std::wstring p(path, n);
+            const size_t slash = p.find_last_of(L'\\');
+            return slash == std::wstring::npos ? std::wstring() : p.substr(0, slash + 1);
+        }
+
+        // "a.dll;b.dll" / "a.dll,b.dll" -> lower-case names
+        std::vector<std::string> SplitList(const char* text)
+        {
+            std::vector<std::string> out;
+            std::string cur;
+            for (const char* p = text; ; ++p)
+            {
+                if (*p == ';' || *p == ',' || *p == '\0')
+                {
+                    size_t b = 0, e = cur.size();
+                    while (b < e && std::isspace(static_cast<unsigned char>(cur[b]))) ++b;
+                    while (e > b && std::isspace(static_cast<unsigned char>(cur[e - 1]))) --e;
+                    if (e > b) out.push_back(Lower(cur.substr(b, e - b)));
+                    cur.clear();
+                    if (*p == '\0') break;
+                }
+                else cur.push_back(*p);
+            }
+            return out;
+        }
+
+        // The DLL's machine type from its PE header, so a 32-bit module is reported as such instead of as
+        // "error 193" from LoadLibrary. Returns 0 when the file cannot be read as a PE image.
+        uint16_t PeMachine(const std::wstring& path)
+        {
+            HANDLE f = CreateFileW(path.c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+            if (f == INVALID_HANDLE_VALUE) return 0;
+            uint8_t head[0x40] = {};
+            DWORD got = 0;
+            uint16_t machine = 0;
+            if (ReadFile(f, head, sizeof(head), &got, nullptr) && got == sizeof(head) && head[0] == 'M' && head[1] == 'Z')
+            {
+                uint32_t peOffset = 0;
+                std::memcpy(&peOffset, head + 0x3C, 4);
+                uint8_t pe[6] = {};
+                if (SetFilePointer(f, static_cast<LONG>(peOffset), nullptr, FILE_BEGIN) != INVALID_SET_FILE_POINTER &&
+                    ReadFile(f, pe, sizeof(pe), &got, nullptr) && got == sizeof(pe) && pe[0] == 'P' && pe[1] == 'E' && pe[2] == 0 && pe[3] == 0)
+                    std::memcpy(&machine, pe + 4, 2);
+            }
+            CloseHandle(f);
+            return machine;
+        }
+
+        // Structured-exception guards around the three calls into foreign code. Plain functions, no C++
+        // objects, so __try is allowed. A module that faults is reported and skipped, not allowed to take
+        // the client down on startup.
+        bool CallAbi(WxlModuleAbiVersionFn fn, uint32_t* out) noexcept
+        {
+            __try { *out = fn(); return true; }
+            __except (EXCEPTION_EXECUTE_HANDLER) { return false; }
+        }
+        bool CallInit(WxlModuleInitFn fn, const WxlApi* api, WxlModuleInfo* info, int* result) noexcept
+        {
+            __try { *result = fn(api, info); return true; }
+            __except (EXCEPTION_EXECUTE_HANDLER) { return false; }
+        }
+        void CallShutdown(WxlModuleShutdownFn fn) noexcept
+        {
+            __try { fn(); }
+            __except (EXCEPTION_EXECUTE_HANDLER) {}
+        }
+
+        void Skip(Loaded& m, const char* why)
+        {
+            m.status.loaded = false;
+            m.status.note = why;
+            wxl::LogCat("MODULE", "%s: skipped, %s", m.status.file.c_str(), why);
+        }
+
+        void LoadOne(const std::wstring& path, const std::string& file, Loaded& m)
+        {
+            m.status.file = file;
+
+            const uint16_t machine = PeMachine(path);
+            if (machine == 0) { Skip(m, "not a readable DLL"); return; }
+            if (machine != IMAGE_FILE_MACHINE_AMD64) { Skip(m, "not a 64-bit DLL (modules are for the 64-bit client)"); return; }
+
+            m.dll = LoadLibraryExW(path.c_str(), nullptr, LOAD_WITH_ALTERED_SEARCH_PATH);
+            if (!m.dll)
+            {
+                char why[96];
+                std::snprintf(why, sizeof(why), "LoadLibrary failed (error %lu: a missing dependency?)", GetLastError());
+                Skip(m, why);
+                return;
+            }
+
+            auto abiFn  = reinterpret_cast<WxlModuleAbiVersionFn>(GetProcAddress(m.dll, "WxlModuleAbiVersion"));
+            auto initFn = reinterpret_cast<WxlModuleInitFn>(GetProcAddress(m.dll, "WxlModuleInit"));
+            m.shutdown  = reinterpret_cast<WxlModuleShutdownFn>(GetProcAddress(m.dll, "WxlModuleShutdown"));
+            if (!abiFn || !initFn)
+            {
+                Skip(m, "does not export WxlModuleAbiVersion / WxlModuleInit: not a WXL module");
+                FreeLibrary(m.dll);
+                m.dll = nullptr;
+                return;
+            }
+
+            uint32_t abi = 0;
+            if (!CallAbi(abiFn, &abi)) { Skip(m, "faulted in WxlModuleAbiVersion"); FreeLibrary(m.dll); m.dll = nullptr; return; }
+            if (abi != WXL_ABI_VERSION)
+            {
+                char why[96];
+                std::snprintf(why, sizeof(why), "built for module ABI %u, this client speaks %u", abi, WXL_ABI_VERSION);
+                Skip(m, why);
+                FreeLibrary(m.dll);
+                m.dll = nullptr;
+                return;
+            }
+
+            WxlModuleInfo info = {};
+            info.structSize = sizeof(info);
+            int result = -1;
+            if (!CallInit(initFn, Table(), &info, &result))
+            {
+                // a fault inside the module's init: the module may be half set up, so it stays loaded and is never called again
+                Skip(m, "faulted in WxlModuleInit");
+                m.shutdown = nullptr;
+                return;
+            }
+            if (result != 0)
+            {
+                char why[96];
+                std::snprintf(why, sizeof(why), "WxlModuleInit refused (returned %d)", result);
+                Skip(m, why);
+                FreeLibrary(m.dll);
+                m.dll = nullptr;
+                m.shutdown = nullptr;
+                return;
+            }
+
+            info.name[sizeof(info.name) - 1] = '\0';
+            m.status.name = info.name;
+            m.status.major = info.versionMajor;
+            m.status.minor = info.versionMinor;
+            m.status.loaded = true;
+            m.status.note = "ok";
+            wxl::LogCat("MODULE", "%s: loaded '%s' %u.%u", file.c_str(), info.name[0] ? info.name : "(unnamed)", info.versionMajor, info.versionMinor);
+        }
+    }
+
+    void LoadModules()
+    {
+        std::lock_guard<std::mutex> lock(g_lock);
+        if (g_done) return;
+        g_done = true;
+
+        if (!eq::WxlIniGetBool("Modules", "Enabled", true))
+        {
+            wxl::LogCat("MODULE", "modules are switched off ([Modules] Enabled=0 in WXLExtendedEquipment.ini)");
+            return;
+        }
+
+        const std::wstring folder = ExeFolder() + L"WXL\\Modules\\";
+        WIN32_FIND_DATAW fd = {};
+        HANDLE h = FindFirstFileW((folder + L"*.dll").c_str(), &fd);
+        if (h == INVALID_HANDLE_VALUE)
+        {
+            wxl::LogCat("MODULE", "no modules (no *.dll in %s)", Narrow(folder).c_str());
+            return;
+        }
+
+        std::vector<std::wstring> names;
+        do
+        {
+            if (!(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)) names.emplace_back(fd.cFileName);
+        } while (FindNextFileW(h, &fd));
+        FindClose(h);
+        std::sort(names.begin(), names.end(), [](const std::wstring& a, const std::wstring& b) {
+            return Lower(Narrow(a)) < Lower(Narrow(b));
+        });
+
+        char disableText[512] = {};
+        eq::WxlIniGetString("Modules", "Disable", disableText, sizeof(disableText));
+        const std::vector<std::string> disabled = SplitList(disableText);
+
+        wxl::LogCat("MODULE", "module API %u, looking in %s (%zu file%s)", WXL_ABI_VERSION, Narrow(folder).c_str(),
+                    names.size(), names.size() == 1 ? "" : "s");
+        g_modules.reserve(names.size());
+        for (const std::wstring& name : names)
+        {
+            g_modules.emplace_back();
+            Loaded& m = g_modules.back();
+            const std::string file = Narrow(name);
+            if (std::find(disabled.begin(), disabled.end(), Lower(file)) != disabled.end())
+            {
+                m.status.file = file;
+                Skip(m, "listed in [Modules] Disable");
+                continue;
+            }
+            LoadOne(folder + name, file, m);
+        }
+    }
+
+    void UnloadModules()
+    {
+        std::lock_guard<std::mutex> lock(g_lock);
+        for (auto it = g_modules.rbegin(); it != g_modules.rend(); ++it)
+        {
+            if (it->shutdown) CallShutdown(it->shutdown);
+            // the DLL stays mapped: its event handlers are still in the bus, and the process is going away
+            it->shutdown = nullptr;
+        }
+    }
+
+    std::vector<ModuleStatus> Modules()
+    {
+        std::lock_guard<std::mutex> lock(g_lock);
+        std::vector<ModuleStatus> out;
+        for (const Loaded& m : g_modules) out.push_back(m.status);
+        return out;
+    }
+
+#else   // 32-bit build, or not Windows: the module API is 64-bit only
+
+    void LoadModules()
+    {
+        wxl::LogCat("MODULE", "the module API is for the 64-bit client: no modules are loaded in this build");
+    }
+    void UnloadModules() {}
+    std::vector<ModuleStatus> Modules() { return {}; }
+
+#endif
+}
