diff --git a/Engine/Source/WXLModules/Physics/CMakeLists.txt b/Engine/Source/WXLModules/Physics/CMakeLists.txt
new file mode 100644
index 0000000..868b045
--- /dev/null
+++ b/Engine/Source/WXLModules/Physics/CMakeLists.txt
@@ -0,0 +1,25 @@
+# WXL physics module: wxl_physics.dll, loaded from <client folder>\WXL\Modules\ by the 64-bit client.
+# It is built against Engine/Source/WXL/Sdk/wxl_api.h and its own folder only: no engine header, no import
+# library of the client. physics_domino.* is third-party code (see README.md).
+if (NOT WOWDECOMP_ARCH_64)
+    message(STATUS "WXL modules are 64-bit only: wxl_physics is not built")
+    return()
+endif ()
+
+file(GLOB PHYSICS_SOURCES CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/*.cpp")
+
+add_library(wxl_physics SHARED ${PHYSICS_SOURCES})
+
+target_include_directories(wxl_physics
+    PRIVATE
+        ${CMAKE_CURRENT_SOURCE_DIR}
+        ${CMAKE_SOURCE_DIR}/Engine/Source/WXL/Sdk
+)
+
+set_target_properties(wxl_physics PROPERTIES
+    PREFIX ""
+    CXX_VISIBILITY_PRESET hidden
+    VISIBILITY_INLINES_HIDDEN ON
+    # "$<1:...>" keeps Visual Studio from adding a Debug/Release sub-folder: the loader looks in WXL\Modules
+    RUNTIME_OUTPUT_DIRECTORY "$<1:${CMAKE_SOURCE_DIR}/bin/Win/WXL/Modules>"
+)
diff --git a/Engine/Source/WXLModules/Physics/Module.cpp b/Engine/Source/WXLModules/Physics/Module.cpp
new file mode 100644
index 0000000..87ec82d
--- /dev/null
+++ b/Engine/Source/WXLModules/Physics/Module.cpp
@@ -0,0 +1,25 @@
+// The physics module's entry points. See Engine/Source/WXL/Sdk/wxl_api.h.
+// Copyright (C) 2026 WarcraftXL (GPLv3, see Engine/Source/WXL/Event.h)
+
+#include "PhysicsLive.hpp"
+
+#include <cstring>
+
+WXL_DEFINE_MODULE_ABI()
+
+WXL_MODULE_API int WxlModuleInit(const WxlApi* api, WxlModuleInfo* info)
+{
+    if (info)
+    {
+        std::strncpy(info->name, "physics", sizeof(info->name) - 1);
+        info->versionMajor = 1;
+        info->versionMinor = 0;
+    }
+    return wxl::equip::physics::Init(api) ? 0 : 1;
+}
+
+WXL_MODULE_API void WxlModuleShutdown(void)
+{
+    // the event handler stays subscribed until the process ends; make it a no-op, and drop every instance
+    wxl::equip::physics::SetEnabled(false);
+}
diff --git a/Engine/Source/WXLModules/Physics/ModuleHost.cpp b/Engine/Source/WXLModules/Physics/ModuleHost.cpp
new file mode 100644
index 0000000..0b26927
--- /dev/null
+++ b/Engine/Source/WXLModules/Physics/ModuleHost.cpp
@@ -0,0 +1,67 @@
+// See ModuleHost.hpp.
+// Copyright (C) 2026 WarcraftXL (GPLv3, see Engine/Source/WXL/Event.h)
+
+#include "ModuleHost.hpp"
+
+#include <cstdarg>
+#include <cstdio>
+#include <cstring>
+
+namespace wxl::modules::host
+{
+    namespace { const WxlApi* g_api = nullptr; }
+
+    void SetApi(const WxlApi* api) { g_api = api; }
+    const WxlApi* Api() { return g_api; }
+
+    bool IniGetBool(const char* section, const char* key, bool defaultValue)
+    {
+        return g_api && g_api->iniGetBool ? g_api->iniGetBool(section, key, defaultValue ? 1 : 0) != 0 : defaultValue;
+    }
+    int IniGetInt(const char* section, const char* key, int defaultValue)
+    {
+        return g_api && g_api->iniGetInt ? g_api->iniGetInt(section, key, defaultValue) : defaultValue;
+    }
+    bool IniGetString(const char* section, const char* key, char* out, size_t cap)
+    {
+        if (out && cap) out[0] = '\0';
+        return g_api && g_api->iniGetString && g_api->iniGetString(section, key, out, cap) != 0;
+    }
+    uint64_t IniStamp() { return g_api && g_api->iniStamp ? g_api->iniStamp() : 0; }
+
+    bool ReadFile(const char* name, std::vector<uint8_t>& out)
+    {
+        if (!g_api || !g_api->readFile || !g_api->freeBuffer) return false;
+        WxlBuffer buf = {};
+        if (!g_api->readFile(name, &buf) || !buf.data) return false;
+        out.assign(static_cast<const uint8_t*>(buf.data), static_cast<const uint8_t*>(buf.data) + buf.size);
+        g_api->freeBuffer(&buf);   // freed by the side that allocated it
+        return true;
+    }
+
+    bool IsVirtualKey(const char* name)
+    {
+        return g_api && g_api->isVirtualKey && g_api->isVirtualKey(name) != 0;
+    }
+}
+
+namespace wxl
+{
+    void LogCat(const char* category, const char* format, ...)
+    {
+        const WxlApi* api = modules::host::Api();
+        if (!api || !api->log) return;
+        char line[1024];
+        va_list args;
+        va_start(args, format);
+        std::vsnprintf(line, sizeof(line), format, args);
+        va_end(args);
+        api->log(category, line);
+    }
+
+    bool LogThrottle(const char* key, unsigned first, unsigned every)
+    {
+        const WxlApi* api = modules::host::Api();
+        return api && api->logThrottle && api->logThrottle(key, first, every) != 0;
+    }
+}
