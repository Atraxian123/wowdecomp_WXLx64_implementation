diff --git a/Engine/Source/WXLApi/ApiHost.h b/Engine/Source/WXLApi/ApiHost.h
new file mode 100644
index 0000000..bf63341
--- /dev/null
+++ b/Engine/Source/WXLApi/ApiHost.h
@@ -0,0 +1,41 @@
+// The core's side of the module API (Engine/Source/WXL/Sdk/wxl_api.h).
+// Copyright (C) 2026 WarcraftXL (GPLv3, see Engine/Source/WXL/Event.h)
+#pragma once
+
+#include "Engine/Source/WXL/Sdk/wxl_api.h"
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace wxl::api
+{
+    /// The table every module receives. Static, valid for the life of the process.
+    const WxlApi* Table();
+
+    /**
+     * @brief Loads every DLL in <client folder>\WXL\Modules (64-bit client only; a no-op on Win32).
+     *
+     * Call once, after wxl::equip::Init(): modules subscribe to events, subscribers run in subscription order,
+     * and a module that wants to see the palette after the built-in extensions have changed it must subscribe
+     * after them. DLLs load in file-name order (prefix a name with 10_, 20_ ... to order them).
+     *
+     * [Modules] in WXLExtendedEquipment.ini:  Enabled=1 (default), Disable=a.dll;b.dll
+     * A DLL that is not a 64-bit module, has the wrong ABI, or refuses to initialize is skipped and logged.
+     */
+    void LoadModules();
+
+    /// Calls every loaded module's WxlModuleShutdown (when it has one), in reverse order, then frees them.
+    void UnloadModules();
+
+    struct ModuleStatus
+    {
+        std::string file;      ///< file name
+        std::string name;      ///< what the module called itself ("" until it initialized)
+        uint32_t    major = 0, minor = 0;
+        bool        loaded = false;
+        std::string note;      ///< why it was skipped, or "ok"
+    };
+    /// What LoadModules found, in load order.
+    std::vector<ModuleStatus> Modules();
+}
diff --git a/Engine/Source/WXLApi/ApiTable.cpp b/Engine/Source/WXLApi/ApiTable.cpp
new file mode 100644
index 0000000..24ff4d3
--- /dev/null
+++ b/Engine/Source/WXLApi/ApiTable.cpp
@@ -0,0 +1,113 @@
+// The table every module receives. See ApiHost.h and Engine/Source/WXL/Sdk/wxl_api.h.
+// Copyright (C) 2026 WarcraftXL (GPLv3, see Engine/Source/WXL/Event.h)
+//
+// Every entry is a thin C-ABI face over something the core already has. Where a function takes or returns a
+// C++ type (std::vector in the storage layer, bool in the ini helpers) this file is the only place that
+// converts, so the types never reach a module.
+
+#include "Engine/Source/WXLApi/ApiHost.h"
+
+#include "Engine/Source/WXL/Event.h"
+#include "Engine/Source/WXL/Log.h"
+#include "Engine/Source/WXL/Storage.h"
+#include "Engine/Source/WXLApi/ModelAccess.h"
+#include "Engine/Source/WXLEquip/VirtualPath.hpp"
+
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+namespace wxl::api
+{
+    namespace
+    {
+        namespace eq = wxl::scripts::equipextension;
+
+        void Log(const char* category, const char* message)
+        {
+            wxl::LogCat(category && *category ? category : "MODULE", "%s", message ? message : "");
+        }
+
+        int LogThrottle(const char* key, uint32_t first, uint32_t every)
+        {
+            return wxl::LogThrottle(key ? key : "", first, every) ? 1 : 0;
+        }
+
+        // Events are matched by name so a module survives the core adding or reordering events.
+        int Subscribe(const char* eventName, WxlEventHandler handler, void* user)
+        {
+            if (!eventName || !handler) return 1;
+            const uint32_t count = static_cast<uint32_t>(wxl::events::Event::Count);
+            for (uint32_t i = 0; i < count; ++i)
+            {
+                const auto e = static_cast<wxl::events::Event>(i);
+                if (std::strcmp(wxl::events::EventName(e), eventName) == 0)
+                {
+                    wxl::events::Subscribe(e, handler, user);   // same signature: void (*)(void*, const void*)
+                    return 0;
+                }
+            }
+            wxl::LogCat("MODULE", "subscribe: unknown event '%s'", eventName);
+            return 2;
+        }
+
+        int IniGetString(const char* section, const char* key, char* out, size_t cap)
+        {
+            return eq::WxlIniGetString(section, key, out, cap) ? 1 : 0;
+        }
+        int IniGetInt(const char* section, const char* key, int defaultValue)
+        {
+            return eq::WxlIniGetInt(section, key, defaultValue);
+        }
+        int IniGetBool(const char* section, const char* key, int defaultValue)
+        {
+            return eq::WxlIniGetBool(section, key, defaultValue != 0) ? 1 : 0;
+        }
+        uint64_t IniStamp() { return eq::WxlIniStamp(); }
+
+        int ReadFile(const char* name, WxlBuffer* out)
+        {
+            if (!name || !out) return 0;
+            out->data = nullptr;
+            out->size = 0;
+            std::vector<uint8_t> bytes;
+            if (!wxl::storage::ReadNativeQuiet(name, bytes) || bytes.empty()) return 0;
+            void* copy = std::malloc(bytes.size());
+            if (!copy) return 0;
+            std::memcpy(copy, bytes.data(), bytes.size());
+            out->data = copy;
+            out->size = bytes.size();
+            return 1;
+        }
+
+        void FreeBuffer(WxlBuffer* buffer)
+        {
+            if (!buffer) return;
+            std::free(buffer->data);
+            buffer->data = nullptr;
+            buffer->size = 0;
+        }
+
+        int IsVirtualKey(const char* name) { return name && eq::VPathIsVirtualKey(name) ? 1 : 0; }
+
+        const WxlApi g_table = {
+            WXL_ABI_VERSION,
+            sizeof(WxlApi),
+            &Log,
+            &LogThrottle,
+            &Subscribe,
+            &IniGetString,
+            &IniGetInt,
+            &IniGetBool,
+            &IniStamp,
+            &ReadFile,
+            &FreeBuffer,
+            &IsVirtualKey,
+            &wxl::api::model::ReadInstance,
+            &wxl::api::model::ReadBones,
+            &wxl::api::model::WritePalette,
+        };
+    }
+
+    const WxlApi* Table() { return &g_table; }
+}
diff --git a/Engine/Source/WXLApi/CMakeLists.txt b/Engine/Source/WXLApi/CMakeLists.txt
new file mode 100644
index 0000000..9f3459b
--- /dev/null
+++ b/Engine/Source/WXLApi/CMakeLists.txt
@@ -0,0 +1,28 @@
+# The module API of the 64-bit client: the table modules call (ApiTable.cpp), the guarded engine reads behind
+# it (ModelAccess.cpp) and the loader that finds WXL\Modules\*.dll (ModuleLoader.cpp). The table is built
+# from what WXLCore and WXLEquip already provide, so this library sits above both. The public header for a
+# module is Engine/Source/WXL/Sdk/wxl_api.h: nothing here is meant to be included by one.
+file(GLOB_RECURSE PRIVATE_SOURCES CONFIGURE_DEPENDS "*.cpp")
+if (NOT WOWDECOMP_ARCH_64)
+    # the module API is 64-bit only: a 32-bit client keeps just the loader's "no modules here" stub
+    list(FILTER PRIVATE_SOURCES EXCLUDE REGEX "(ApiTable|ModelAccess)\\.cpp$")
+endif ()
+
+add_library(WXLApi STATIC
+    ${PRIVATE_SOURCES}
+)
+
+if (NOT WOWDECOMP_ARCH_64)
+    target_compile_definitions(WXLApi PUBLIC WXL_ALLOW_32BIT_HEADER=1)
+endif ()
+
+target_include_directories(WXLApi
+    PUBLIC
+        ${CMAKE_SOURCE_DIR}
+)
+
+target_link_libraries(WXLApi
+    PUBLIC
+        WXLCore
+        WXLEquip
+)
diff --git a/Engine/Source/WXLApi/ModelAccess.cpp b/Engine/Source/WXLApi/ModelAccess.cpp
