diff --git a/Engine/Source/WXL/RibbonBlend.cpp b/Engine/Source/WXL/RibbonBlend.cpp
new file mode 100644
index 0000000..f3ae5fe
--- /dev/null
+++ b/Engine/Source/WXL/RibbonBlend.cpp
@@ -0,0 +1,115 @@
+// How the textures of a multi-textured ribbon emitter combine. See RibbonBlend.h.
+// Copyright (C) 2026 WarcraftXL (GPLv3, see Event.h)
+
+#include "Engine/Source/WXL/RibbonBlend.h"
+
+#include "Engine/Source/WXL/Log.h"
+
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+#include <cstdio>
+#include <cstring>
+
+namespace wxl::ribbonblend
+{
+    namespace
+    {
+        // WXLSetup.ini sits in the WXL folder beside the client executable; a copy left beside the executable (the
+        // old place) is still read. The lookup is repeated here because WXLCore keeps no shared ini helper, as in
+        // ParticleCsv.cpp and Culling.cpp. Missing file, section or key: the default.
+        std::string IniString(const char* section, const char* key, const char* def)
+        {
+#ifdef _WIN32
+            char path[MAX_PATH] = {};
+            const DWORD n = GetModuleFileNameA(nullptr, path, static_cast<DWORD>(sizeof(path)));
+            if (n == 0 || n >= sizeof(path)) return def;
+            char* slash = std::strrchr(path, '\\');
+            const char* name = "WXLSetup.ini";
+            if (!slash || static_cast<size_t>(slash - path) + 1 + std::strlen(name) >= sizeof(path)) return def;
+            std::strcpy(slash + 1, name);
+            char inWxl[MAX_PATH] = {};
+            if (static_cast<size_t>(slash - path) + 5 + std::strlen(name) < sizeof(inWxl))
+            {
+                std::snprintf(inWxl, sizeof(inWxl), "%.*sWXL\\%s", static_cast<int>(slash - path) + 1, path, name);
+                if (GetFileAttributesA(inWxl) != INVALID_FILE_ATTRIBUTES) std::strcpy(path, inWxl);
+            }
+            char value[64] = {};
+            GetPrivateProfileStringA(section, key, def, value, static_cast<DWORD>(sizeof(value)), path);
+            return value;
+#else
+            (void)section; (void)key;
+            return def;
+#endif
+        }
+
+        std::string Normalize(const std::string& s)
+        {
+            size_t b = 0, e = s.size();
+            while (b < e && (s[b] == ' ' || s[b] == '\t' || s[b] == '\r' || s[b] == '\n')) ++b;
+            while (e > b && (s[e - 1] == ' ' || s[e - 1] == '\t' || s[e - 1] == '\r' || s[e - 1] == '\n')) --e;
+            std::string out = s.substr(b, e - b);
+            for (char& c : out) if (c >= 'A' && c <= 'Z') c = static_cast<char>(c - 'A' + 'a');
+            return out;
+        }
+    }
+
+    Mode ParseMode(const std::string& text, bool* recognized)
+    {
+        const std::string t = Normalize(text);
+        if (recognized) *recognized = true;
+        if (t.empty() || t == "off" || t == "0" || t == "no" || t == "none" || t == "false") return Mode::Off;
+        if (t == "multiply" || t == "multiplicative" || t == "mul") return Mode::Multiply;
+        if (t == "add" || t == "additive") return Mode::Add;
+        if (recognized) *recognized = false;
+        return Mode::Off;
+    }
+
+    int ParseGain(const std::string& text, bool* recognized)
+    {
+        const std::string t = Normalize(text);
+        if (recognized) *recognized = true;
+        if (t.empty()) return 2;
+        if (t == "1") return 1;
+        if (t == "2") return 2;
+        if (t == "4") return 4;
+        if (recognized) *recognized = false;
+        return 2;
+    }
+
+    void StageOps(uint32_t layers, int colorGain, bool plainAlpha, StageOp* out)
+    {
+        const uint32_t doubling = colorGain >= 4 ? 2u : colorGain == 2 ? 1u : 0u;   // how many of the last stages double the colour
+        for (uint32_t k = 0; k < layers; ++k)
+        {
+            out[k].colorDouble = k + doubling >= layers;
+            out[k].alphaDouble = !plainAlpha && out[k].colorDouble;
+        }
+    }
+
+    Mode MultiTextureBlend()
+    {
+        static const Mode mode = [] {
+            const std::string text = IniString("Ribbons", "MultiTextureBlend", "");
+            bool ok = true;
+            const Mode m = ParseMode(text, &ok);
+            if (!ok) wxl::LogCat("RIBBON", "[Ribbons] MultiTextureBlend='%s' is not Off, Multiply or Add; Off", text.c_str());
+            wxl::LogCat("RIBBON", "multi-textured ribbons: %s", m == Mode::Multiply ? "multiply" : m == Mode::Add ? "add" : "off (as the model has it)");
+            return m;
+        }();
+        return mode;
+    }
+
+    int MultiTextureGain()
+    {
+        static const int gain = [] {
+            const std::string text = IniString("Ribbons", "MultiTextureGain", "");
+            bool ok = true;
+            const int g = ParseGain(text, &ok);
+            if (!ok) wxl::LogCat("RIBBON", "[Ribbons] MultiTextureGain='%s' is not 1, 2 or 4; 2", text.c_str());
+            return g;
+        }();
+        return gain;
+    }
+}
diff --git a/Engine/Source/WXL/RibbonBlend.h b/Engine/Source/WXL/RibbonBlend.h
new file mode 100644
index 0000000..38c8721
--- /dev/null
+++ b/Engine/Source/WXL/RibbonBlend.h
@@ -0,0 +1,61 @@
+// How the textures of a multi-textured ribbon emitter combine. Opt-in.
+// Copyright (C) 2026 WarcraftXL (GPLv3, see Event.h)
+//
+// A ribbon emitter can name up to four texture layers. The stock client draws one pass per layer, each blended into
+// the frame on its own with the blend mode of its own material. When WXLSetup.ini says
+//
+//     [Ribbons]
+//     MultiTextureBlend=Multiply     ; Off (default), Multiply or Add
+//     MultiTextureGain=2             ; Multiply only: 1, 2 or 4
+//
+// every ribbon with two or more textures, of a native Wrath model or a modern one alike, is drawn the chosen way. A
+// ribbon with a single texture is never touched: it keeps the blending of its model.
+//
+//   Multiply   ONE pass: texture0 * texture1 [* texture2 [* texture3]] * the ribbon's vertex colour, in colour and in
+//              alpha, blended into the frame the way the first layer's material says. The alpha is the plain product
+//              of the layers' alphas (and the ribbon's own alpha); it is never scaled. A solid white layer is neutral.
+//   Add        one pass per texture, each added into the frame on its own (blend mode "add", whatever the material
+//              says), so the layers sum. A solid layer then adds a solid area: this suits ribbons whose layers are
+//              all soft masks.
+//
+// MultiTextureGain (Multiply): the colour of the product is multiplied once more by 2 (the last stage doubles: 2, the
+// default, which makes a 50 percent grey layer neutral), by 4 (the last two stages double), or not at all (1).
+//
+// Off (the default) changes nothing from what the client did before this setting: a modern model's multi-textured
+// ribbons are one multiplied pass as the model loader has always made them, and a native Wrath model's are drawn
+// by the stock client, one pass per layer with the material's own blend mode.
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace wxl::ribbonblend
+{
+    enum class Mode { Off, Multiply, Add };
+
+    /// "multiply" / "multiplicative", "add" / "additive", "off" / "0" / "no" / "none" / "" (any case) to the mode;
+    /// anything else is Off and `recognized` (when given) is false.
+    Mode ParseMode(const std::string& text, bool* recognized = nullptr);
+
+    /// "1", "2" or "4" to itself, "" to 2; anything else is 2 and `recognized` (when given) is false.
+    int ParseGain(const std::string& text, bool* recognized = nullptr);
+
+    /// What one texture stage of the multiplied pass does with the result of the stage before it: modulate (multiply),
+    /// or modulate and double.
+    struct StageOp
+    {
+        bool colorDouble = false;
+        bool alphaDouble = false;
+    };
+
+    /// The ops of the `layers` stages (1..4) of the multiplied pass; `out` has room for `layers`. `colorGain` is the
+    /// factor of the whole chain on the colour: 1 no stage doubles, 2 the last one does, 4 the last two do. With
+    /// `plainAlpha` the alpha never doubles; without it the alpha follows the colour (the stock fold, gain 4).
+    void StageOps(uint32_t layers, int colorGain, bool plainAlpha, StageOp* out);
+
+    /// WXLSetup.ini [Ribbons] MultiTextureBlend. Read once, logged once.
+    Mode MultiTextureBlend();
+
+    /// WXLSetup.ini [Ribbons] MultiTextureGain (default 2). Read once.
+    int MultiTextureGain();
+}
diff --git a/Tools/WxlModuleTest/ribbon_blend_test.cpp b/Tools/WxlModuleTest/ribbon_blend_test.cpp
new file mode 100644
index 0000000..6a50d45
--- /dev/null
+++ b/Tools/WxlModuleTest/ribbon_blend_test.cpp
@@ -0,0 +1,56 @@
+// Multi-textured ribbons: the [Ribbons] setting values and the stage ops of the multiplied pass.
+#include "Engine/Source/WXL/RibbonBlend.h"
+
+#include <cstdio>
+
+using namespace wxl::ribbonblend;
+
+static int g_failed = 0;
+static void Check(bool ok, const char* what) { if (!ok) { ++g_failed; std::printf("  FAIL: %s\n", what); } }
+
+static int Doubled(const StageOp* ops, uint32_t n, bool alpha)
+{
+    int d = 0;
+    for (uint32_t k = 0; k < n; ++k) d += (alpha ? ops[k].alphaDouble : ops[k].colorDouble) ? 1 : 0;
+    return d;
+}
+
+int main()
+{
+    std::printf("1. MultiTextureBlend values\n");
+    {
+        bool ok = false;
+        Check(ParseMode("", &ok) == Mode::Off && ok, "empty: Off");
+        Check(ParseMode("Off", &ok) == Mode::Off && ok && ParseMode("0", &ok) == Mode::Off && ok && ParseMode(" no ", &ok) == Mode::Off && ok, "Off, 0, no");
+        Check(ParseMode("Multiply", &ok) == Mode::Multiply && ok && ParseMode("MULTIPLICATIVE", &ok) == Mode::Multiply && ok, "Multiply in any case");
+        Check(ParseMode("add", &ok) == Mode::Add && ok && ParseMode("  Additive\r", &ok) == Mode::Add && ok, "Add, with spaces and a stray CR");
+        Check(ParseMode("screen", &ok) == Mode::Off && !ok, "unknown: Off, not recognized");
+        Check(ParseMode("multiply") == Mode::Multiply, "works without the flag too");
+    }
+    std::printf("2. MultiTextureGain values\n");
+    {
+        bool ok = false;
+        Check(ParseGain("", &ok) == 2 && ok, "empty: 2");
+        Check(ParseGain("1", &ok) == 1 && ok && ParseGain("2", &ok) == 2 && ok && ParseGain(" 4 ", &ok) == 4 && ok, "1, 2, 4");
+        Check(ParseGain("3", &ok) == 2 && !ok && ParseGain("two", &ok) == 2 && !ok, "anything else: 2, not recognized");
+    }
+    std::printf("3. stage ops\n");
+    {
+        StageOp ops[4];
+        for (uint32_t layers = 2; layers <= 4; ++layers)
+        {
+            StageOps(layers, 1, true, ops);
+            Check(Doubled(ops, layers, false) == 0 && Doubled(ops, layers, true) == 0, "gain 1: nothing doubles");
+            StageOps(layers, 2, true, ops);
+            Check(Doubled(ops, layers, false) == 1 && ops[layers - 1].colorDouble && Doubled(ops, layers, true) == 0, "gain 2: the last stage doubles the colour, alpha stays plain");
+            StageOps(layers, 4, true, ops);
+            Check(Doubled(ops, layers, false) == 2 && ops[layers - 1].colorDouble && ops[layers - 2].colorDouble && Doubled(ops, layers, true) == 0, "gain 4: the last two double the colour, alpha stays plain");
+            StageOps(layers, 4, false, ops);
+            Check(Doubled(ops, layers, false) == 2 && Doubled(ops, layers, true) == 2, "the stock fold: colour and alpha double on the last two stages, as before");
+        }
+        StageOps(2, 4, false, ops);
+        Check(ops[0].colorDouble && ops[1].colorDouble && ops[0].alphaDouble && ops[1].alphaDouble, "two layers, stock fold: both stages double, the x4 it always had");
+    }
+    std::printf(g_failed ? "\n%d check(s) FAILED\n" : "\nall checks passed\n", g_failed);
+    return g_failed ? 1 : 0;
+}
